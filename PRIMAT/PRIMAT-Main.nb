Cell["\<\
Two methods to get the total energy density. Either from energy density of \
neutrinos or from temperature. This should be (and it is...) totally \
equivalent.\
\>", "Text",ExpressionUUID->"95893bda-5f8a-40fb-a9b1-baee88c802dc"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"\[Rho]tot1", "[", "T_", "]"}], ":=", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"aBB", " ", 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"kB", " ", "T"}], ")"}], "4"], 
       RowBox[{"(", 
        RowBox[{"1", "+", 
         RowBox[{"D\[Rho]T", "[", "T", "]"}]}], ")"}]}], "+", 
      RowBox[{"\[Rho]\[Nu]", "[", "T", "]"}], "+", 
      RowBox[{"\[Rho]\[Nu]Relat", "[", "T", "]"}], "\[IndentingNewLine]", "+", 
      RowBox[{"nbaryons0", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"mbaryon0", "*", 
            RowBox[{"(", 
             RowBox[{"1", "+", 
              RowBox[{"h2\[CapitalOmega]c0", "/", "h2\[CapitalOmega]b0"}]}], 
             ")"}]}], "+", 
           RowBox[{
            FractionBox["3", "2"], 
            RowBox[{"(", 
             RowBox[{"kB", " ", "T"}], ")"}]}]}], ")"}], "/", 
         SuperscriptBox[
          RowBox[{"(", "clight", ")"}], "2"]}], "/", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"a", "[", "T", "]"}], ")"}], "3"]}]}], 
      "\[IndentingNewLine]", "+", 
      RowBox[{"If", "[", 
       RowBox[{"$EDEBool", ",", 
        RowBox[{"\[Rho]EDE", "[", 
         RowBox[{"a", "[", "T", "]"}], "]"}], ",", "0"}], "]"}]}], ")"}]}], 
   ";"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"Added", " ", "EDE"}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Rho]tot2", "[", "T_", "]"}], ":=", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"aBB", " ", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"kB", " ", "T"}], ")"}], "4"], 
