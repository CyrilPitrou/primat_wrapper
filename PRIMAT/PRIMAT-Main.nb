c0c60f944fc9"],

Cell["\<\
Energy density corrections are obtained from the thermodynamic identity \
\[Rho] = -P + T dP/dT. See Eq. 50 of companion paper.\
\>", "Text",
 InitializationCell->
  True,ExpressionUUID->"846d03aa-9a30-4cc6-a0ac-8ab1140c3090"],

Cell[BoxData[{
 RowBox[{"Clear", "[", "d\[Rho]", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"d\[Rho]", "[", "T_", "]"}], ":=", 
  RowBox[{
   RowBox[{"d\[Rho]", "[", "T", "]"}], "=", 
   RowBox[{
    RowBox[{"-", 
     RowBox[{"dP", "[", "T", "]"}]}], "+", 
    RowBox[{"T", " ", 
     RowBox[{
      RowBox[{"dPI", "'"}], "[", "T", "]"}]}]}]}]}]}], "Input",
