  RowBox[{
   RowBox[{"aT", " ", "and", " ", "z"}], "=", 
   RowBox[{
    SubscriptBox["aT", "\[Nu]"], " ", "respectively"}]}]}]], "Text",
 CellChangeTimes->{{3.7177504094176083`*^9, 3.717750431977358*^9}, {
  3.722686110137854*^9, 
  3.722686110968451*^9}},ExpressionUUID->"f7985c39-3418-40a0-a58f-\
da87ae234a75"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"zT", "[", "T_", "]"}], ":=", 
   FractionBox[
    RowBox[{"(", 
     RowBox[{
      RowBox[{"a", "[", "T", "]"}], "T"}], ")"}], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"a", "[", "Ti", "]"}], "Ti"}], ")"}]]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"znuT", "[", "T_", "]"}], ":=", 
   FractionBox[
    RowBox[{"(", 
     RowBox[{
      RowBox[{"a", "[", "T", "]"}], 
      RowBox[{"T\[Nu]overT", "[", "T", "]"}], " ", "T"}], ")"}], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"a", "[", "Ti", "]"}], 
      RowBox[{"T\[Nu]overT", "[", "Ti", "]"}], " ", "Ti"}], ")"}]]}], 
  ";"}]}], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.7177503782067842`*^9, 3.7177504075173817`*^9}, {
   3.717750662725389*^9, 3.7177506797656803`*^9}, 3.717750817263707*^9, {
