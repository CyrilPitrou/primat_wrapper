Cell[TextData[{
 "NB : ArcTanh[x] = 1/2 Log[",
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{"(", 
     RowBox[{"1", "+", "x"}], ")"}], 
    RowBox[{"(", 
     RowBox[{"1", "-", "x"}], ")"}]], TraditionalForm]],ExpressionUUID->
  "47423258-702e-4827-80c0-0f1796449179"],
 "]"
}], "Text",
