Cell[CellGroupData[{

Cell["Loading neutrino decoupling results from NEVO", "Subsection",ExpressionUUID->"c4b761a6-04ee-489f-b9c5-8efb19d2e7ea"],

Cell[BoxData[
 RowBox[{"We", " ", "load", " ", "the", " ", "file", " ", "which", " ", 
  "stores", " ", "the", " ", "grid", "  ", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{"in", " ", "y"}], " ", "=", " ", 
    RowBox[{"p", "/", "Tcm"}]}], ")"}], " ", "on", " ", "which", " ", "NEVO", 
  " ", "results", " ", "are", " ", 
  RowBox[{"provided", "."}]}]], "Text",
 CellChangeTimes->{{3.93496457843824*^9, 3.934964585121429*^9}, {
  3.935569594937113*^9, 3.93556961029558*^9}, {3.937274965604485*^9, 
  3.9372749939059153`*^9}},
 FontFamily->"Arial",ExpressionUUID->"c66a1a02-579f-4bf1-901a-0f44ab1816f3"],

Cell[BoxData[
 RowBox[{"LoadNEVOGrid", ":=", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{"$NEVO", ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Not", "[", 
           RowBox[{"ValueQ", "[", "LinearGrid", "]"}], "]"}], "||", 
          "$RecomputeWeakRates"}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"FileGrid", "=", 
           RowBox[{
           "$CSVDirectory", "<>", "\"\<NEVOGrid\>\"", "<>", "$FileSuffix", 
            "<>", "\"\<.csv\>\""}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"TableGrid", "=", 
           RowBox[{"Flatten", "@", 
            RowBox[{"SafeImport", "[", 
             RowBox[{"FileGrid", ",", "\"\<CSV\>\""}], "]"}]}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"ymin", "=", 
           RowBox[{"First", "@", "TableGrid"}]}], ";", "\[IndentingNewLine]", 
          
          RowBox[{"ymax", " ", "=", 
           RowBox[{"Last", "@", "TableGrid"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"GS", "=", 
           RowBox[{"Length", "[", "TableGrid", "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"Ny", "=", "GS"}], ";", "\[IndentingNewLine]", 
          RowBox[{"LinearGrid", "=", 
           RowBox[{"DeleteDuplicates", "[", 
            RowBox[{"Join", "[", 
             RowBox[{
              RowBox[{"Table", "[", 
               RowBox[{"y", ",", 
                RowBox[{"{", 
                 RowBox[{"y", ",", "ymin", ",", "ymax", ",", 
                  RowBox[{
                   RowBox[{"(", 
                    RowBox[{"ymax", "-", "ymin"}], ")"}], "/", 
                   RowBox[{"(", 
                    RowBox[{"Ny", "-", "1"}], ")"}]}]}], "}"}]}], "]"}], ",", 
              
              RowBox[{"{", "ymax", "}"}]}], "]"}], "]"}]}], ";"}]}], 
        "\[IndentingNewLine]", "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], 
    ";"}], "\[IndentingNewLine]", ")"}]}]], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.934964216668354*^9, 3.934964236725067*^9}, {
   3.934964283890222*^9, 3.934964301095991*^9}, 3.934964468259618*^9, 
   3.934964575515979*^9, {3.934965585541032*^9, 3.934965586014164*^9}, {
   3.9349656168433857`*^9, 3.934965633420542*^9}, {3.936190284452739*^9, 
   3.936190289354086*^9}, {3.93635548939843*^9, 3.936355497229281*^9}, {
   3.936355591493734*^9, 3.936355617120707*^9}, {3.9363558190664797`*^9, 
   3.9363558204913683`*^9}, {3.936368716550338*^9, 3.9363687404834146`*^9}, {
   3.9363709830890913`*^9, 3.936371032166471*^9}, {3.93637107820711*^9, 
   3.9363710826590033`*^9}, {3.9363712955197563`*^9, 3.9363713044525557`*^9}, 
   3.936401484889504*^9, {3.937181203078643*^9, 3.937181204855563*^9}},
 CellLabel->
  "In[237]:=",ExpressionUUID->"c669ade3-b371-4557-bd0b-6b716b14fd8b"],

Cell["\<\
The grid in comoving momentum (variable y = a p), is stored in the file \
NEVOGrid which has been loaded in FileGrid \
\>", "Text",ExpressionUUID->"4437955e-307d-4056-8e7f-bd911514e3ef"],

Cell[BoxData["LoadNEVOGrid"], "Input",
 CellChangeTimes->{3.936355822921011*^9},
 CellLabel->
  "In[238]:=",ExpressionUUID->"d68a730b-9bdb-4828-b0b4-1f29c7b663eb"],

Cell["\<\
If QED effects are taken into account, we import results from a NEVO \
simulation incorporating the same QED corrections to the pressure and the \
energy density (but not to the weak rates of the reactions relevant from \
neutrino decoupling, as it results in a higher order effect).\
\>", "Text",
 CellChangeTimes->{{3.782799311459034*^9, 3.782799363163158*^9}, {
   3.782799397427043*^9, 3.782799427124404*^9}, {3.782799495316697*^9, 
   3.7827995508449697`*^9}, {3.782799621974224*^9, 3.7827999225997334`*^9}, {
   3.782800344188129*^9, 3.782800548349637*^9}, {3.7828006078940477`*^9, 
   3.782800633955887*^9}, {3.782800673644404*^9, 3.782800767885181*^9}, 
   3.782808543811873*^9},ExpressionUUID->"85bb89d3-c682-4f1d-94e3-\
1de7ac69750c"],

Cell[TextData[{
 "In NEVO, the \[OpenCurlyDoubleQuote]time\[CloseCurlyDoubleQuote] variable \
(proxy for the scale factor) is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["x", "NEVO"], "\[Proportional]", 
    RowBox[{
     SubscriptBox["m", "e"], "a"}]}], TraditionalForm]],ExpressionUUID->
  "98b57671-3d57-4361-b3d9-061d876364b6"],
 ", while in PRIMAT we have used the notation ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", "=", 
    RowBox[{"1", "/", 
     RowBox[{"(", 
      RowBox[{
       SubscriptBox["k", "B"], "T"}], ")"}]}]}], TraditionalForm]],
  ExpressionUUID->"6201441d-e008-4abf-acbf-6ac956ea9acf"],
 ".\nTo avoid possible confusion we explicitly use xNEVO below. \nSee e.g. \
[Froustey et al. 2020] for historical definitions of x, y, z in the context \
of neutrino decoupling ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    SubscriptBox["y", "NEVO"]}], TraditionalForm]],ExpressionUUID->
  "d455b35d-57df-441b-a149-e836ea484a58"],
 " = a p and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["z", "NEVO"], TraditionalForm]],ExpressionUUID->
  "54b78289-19ca-498d-95c8-5e45b246e9ed"],
 "= a ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["T", "\[Gamma]"], TraditionalForm]],ExpressionUUID->
  "19670045-9515-4158-a89a-468801eec5c6"],
 "), but this notation is standard in neutrino decoupling literature."
}], "Text",
 CellChangeTimes->{
  3.809770001022314*^9, {3.935569625828795*^9, 
   3.9355696263931513`*^9}},ExpressionUUID->"9db9fa24-d52e-4354-b6d1-\
dc30c2750425"],

Cell["\<\
A function to read the actual NEVO results and perform all needed \
interpolations :\
\>", "Text",
 CellChangeTimes->{{3.937275027916147*^9, 
  3.937275043797802*^9}},ExpressionUUID->"7d31137b-33c2-400d-b189-\
802708c54bb1"],

Cell[BoxData[
 RowBox[{
  RowBox[{"TreatNEVOFile", "[", "fn_", "]"}], ":=", 
  RowBox[{"(", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"TableNEVO", " ", "=", 
     RowBox[{"TableNEVOLoaded", "[", "fn", "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"(*", 
     RowBox[{"First", " ", "column", " ", "of", " ", 
      RowBox[{"NEVO", ".", "cvs"}], " ", "file", " ", "is", " ", "xNEVO"}], 
     "*)"}], "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"xNEVO", "[", "fn", "]"}], "=", 
     RowBox[{"TableNEVO", "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", "1"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
    
    RowBox[{"(*", " ", 
     RowBox[{"Second", " ", "column", " ", "is", " ", "zNEVO"}], "*)"}], 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"zNEVO", "[", "fn", "]"}], "=", 
     RowBox[{"TableNEVO", "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", "2"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
    
    RowBox[{"(*", " ", 
     RowBox[{
     "By", " ", "definition", " ", "the", " ", "temperature", " ", "of", " ", 
      "photons", " ", "is", " ", "related", " ", 
      RowBox[{"by", " ", ":"}]}], " ", "*)"}], "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"T\[Gamma]NEVO", "[", "fn", "]"}], "=", 
     RowBox[{"me", "*", 
      RowBox[{
       RowBox[{
        RowBox[{"zNEVO", "[", "fn", "]"}], "/", 
        RowBox[{"xNEVO", "[", "fn", "]"}]}], "/", "kB"}]}]}], ";", 
    "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"(*", " ", 
     RowBox[{
      RowBox[{
      "The", " ", "heating", " ", "function", " ", "\[ScriptCapitalN]"}], ",",
       " ", 
      RowBox[{"is", " ", "the", " ", "6", "th", " ", "column"}]}], " ", 
     "*)"}], "\[IndentingNewLine]", 
