               RowBox[{"RescaleElectricDipole", "[", 
                RowBox[{"\"\<He3\>\"", ",", "\"\<a\>\"", ",", "\"\<Be7\>\""}],
                 "]"}], "[", "T9", "]"}]}], ";"}]}], "]"}], ";"}]}], 
        "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"MySet", "[", 
        RowBox[{"Lname", ",", 
         RowBox[{"MyInterpolationRate", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"#", "[", 
               RowBox[{"[", "1", "]"}], "]"}], ",", 
              RowBox[{"Identity", "[", 
               RowBox[{"rescalefactor", " ", "*", 
                RowBox[{"RescaleFunction", "[", 
                 RowBox[{
                  RowBox[{"#", "[", 
                   RowBox[{"[", "1", "]"}], "]"}], "/", "Giga"}], "]"}], "*", 
                " ", 
                RowBox[{"#", "[", 
                 RowBox[{"[", "2", "]"}], "]"}], "*", "\[IndentingNewLine]", 
                RowBox[{"If", "[", 
                 RowBox[{"$RandomNuclearRates", ",", 
