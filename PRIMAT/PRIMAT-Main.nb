                "]"}], "[", "T9", "]"}]}], ";"}]}], "]"}], ";", 
          "\[IndentingNewLine]", "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"Name", "===", "\"\<taTOLi7g\>\""}], ",", 
            RowBox[{
             RowBox[{
              RowBox[{"RescaleFunction", "[", "T9_", "]"}], ":=", 
              RowBox[{
               RowBox[{"RescaleElectricDipole", "[", 
                RowBox[{"\"\<t\>\"", ",", "\"\<a\>\"", ",", "\"\<Li7\>\""}], 
                "]"}], "[", "T9", "]"}]}], ";"}]}], "]"}], ";", 
          "\[IndentingNewLine]", "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"Name", "===", "\"\<He3aTOBe7g\>\""}], ",", 
            RowBox[{
             RowBox[{
              RowBox[{"RescaleFunction", "[", "T9_", "]"}], ":=", 
