     RowBox[{"10", "^", "8"}], ",", 
     RowBox[{"10", "^", "12"}]}], "}"}], ",", 
   RowBox[{"PlotRange", "\[Rule]", "All"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"LogLogPlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\[ScriptCapitalN]", "[", 
      RowBox[{"me", "/", 
       RowBox[{"(", 
        RowBox[{"kB", "*", "Tv"}], ")"}]}], "]"}], ",", 
     RowBox[{"\[ScriptCapitalN]Parthenope", "[", 
