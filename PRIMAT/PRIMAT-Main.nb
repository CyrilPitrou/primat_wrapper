Cell[BoxData[
 RowBox[{
  RowBox[{"LoadDistortions", ":=", 
   RowBox[{"(", "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"If", "[", 
      RowBox[{"$SpectralDistortions", ",", "\[IndentingNewLine]", "\t", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{"$AnalyticDistortions", ",", "\[IndentingNewLine]", "\t", 
          RowBox[{
           RowBox[{"If", "[", 
            RowBox[{"$Verbose", ",", 
             RowBox[{
              RowBox[{
              "Print", "[", "\"\<Loading analytic distortions\>\"", "]"}], 
              ";"}]}], "]"}], ";", "\[IndentingNewLine]", "\t", 
           RowBox[{"(*", 
            RowBox[{"analytic", " ", "distortions"}], "*)"}], 
           "\[IndentingNewLine]", "\t", 
           RowBox[{"(*", " ", 
            RowBox[{
            "This", " ", "is", " ", "where", " ", "we", " ", "put", " ", 
             "the", " ", "analytic", " ", "form", " ", "of", " ", 
             "distortions", " ", "in", " ", "ad", " ", "hoc", " ", "analytic",
              " ", "form"}], " ", "*)"}], "\[IndentingNewLine]", 
           "\[IndentingNewLine]", "\t", 
           RowBox[{
            RowBox[{"dFDneuRawy", "[", 
             RowBox[{"y_", ",", "\[Xi]_", ",", "ysz_"}], "]"}], "=", 
            RowBox[{
             RowBox[{"MuDistortionNeutrinos", "[", 
              RowBox[{"y", ",", "\[Xi]", ",", "\[CapitalDelta]\[Xi]\[Nu]"}], 
              "]"}], "+", 
             RowBox[{"ysz", "*", 
              RowBox[{"YDistortionNeutrinos", "[", 
               RowBox[{"y", ",", "\[Xi]"}], "]"}]}]}]}], ";", 
           "\[IndentingNewLine]", "\t", 
           RowBox[{
            RowBox[{"dFDantineuRawy", "[", 
             RowBox[{"y_", ",", "\[Xi]_", ",", "ysz_"}], "]"}], "=", 
            RowBox[{
             RowBox[{"MuDistortionAntineutrinos", "[", 
              RowBox[{"y", ",", "\[Xi]", ",", "\[CapitalDelta]\[Xi]\[Nu]"}], 
              "]"}], "+", 
             RowBox[{"ysz", "*", 
              RowBox[{"YDistortionAntineutrinos", "[", 
               RowBox[{"y", ",", "\[Xi]"}], "]"}]}]}]}], ";", 
           "\[IndentingNewLine]", "\[IndentingNewLine]", "\t", 
           RowBox[{"(*", " ", 
            RowBox[{
             RowBox[{
              RowBox[{
              "However", " ", "this", " ", "distortion", " ", "is", " ", 
               "called", " ", "with", " ", "en"}], "=", 
              RowBox[{"E", "/", "me"}]}], ",", "\[Phi]", ",", 
             RowBox[{"x", "=", 
              RowBox[{
               RowBox[{
                RowBox[{"me", "/", 
                 RowBox[{"(", 
                  RowBox[{"kB", " ", "T\[Gamma]"}], ")"}]}], " ", "and", " ", 
                "znu"}], " ", "=", " ", 
               RowBox[{"me", "/", 
                RowBox[{"(", 
                 RowBox[{"kB", " ", "T\[Nu]"}], ")"}]}]}]}], ",", " ", 
             RowBox[{
              RowBox[{"hence", " ", "we", " ", "build", " ", "y"}], " ", "=", 
              " ", 
              RowBox[{"en", "*", "znu"}]}]}], " ", "*)"}], 
           "\[IndentingNewLine]", "\t", 
           RowBox[{
            RowBox[{"dFDneuRaw", "[", 
             RowBox[{"en_", ",", "\[Phi]_", ",", "x_", ",", "znu_"}], "]"}], ":=", 
            RowBox[{"dFDneuRawy", "[", 
             RowBox[{
              RowBox[{"en", "*", "znu"}], ",", "\[Phi]", ",", "YSZ"}], 
             "]"}]}], ";", 
           RowBox[{"(*", 
            RowBox[{
            "The", " ", "function", " ", "expects", " ", "the", " ", 
             "temperature", " ", "of", " ", "photons", " ", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"via", " ", "x"}], " ", "=", " ", 
               RowBox[{
                RowBox[{"me", "/", "kB"}], " ", "T\[Gamma]"}]}], ")"}], " ", 
             "but", " ", "it", " ", "is", " ", "not", " ", "used", " ", "in", 
             " ", "the", " ", "distortion", " ", "of", " ", "neutrinos"}], 
            " ", "*)"}], " ", "\[IndentingNewLine]", "\t", 
           RowBox[{
            RowBox[{"dFDantineuRaw", "[", 
             RowBox[{"en_", ",", "\[Phi]_", ",", "x_", ",", "znu_"}], "]"}], ":=", 
            RowBox[{"dFDantineuRawy", "[", 
             RowBox[{
              RowBox[{"en", "*", "znu"}], ",", "\[Phi]", ",", "YSZ"}], 
             "]"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", "\t", 
           RowBox[{"(*", 
            RowBox[{
            "The", " ", "energy", " ", "density", " ", "in", " ", "the", " ", 
             "distortion", " ", "must", " ", "be", " ", "added", " ", "later",
              " ", "for", " ", "the", " ", "Friedmann", " ", "equation"}], 
            "*)"}], "\[IndentingNewLine]", "\t", 
           RowBox[{"(*", " ", 
            RowBox[{
             RowBox[{
             "Replace", " ", "NeutrinosGenerations", " ", "by", " ", "1", " ",
               "if", " ", "the", " ", "distortions", " ", "are", " ", "only", 
              " ", "in", " ", "electronic", " ", 
              RowBox[{"(", "anti", ")"}]}], "-", 
             RowBox[{"neutrinos", "."}]}], " ", "*)"}], "\[IndentingNewLine]",
            "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"\[Rho]\[Nu]SD", "[", "Tnu_", "]"}], ":=", 
            RowBox[{"NeutrinosGenerations", "*", 
             FractionBox[
              SuperscriptBox[
               RowBox[{"(", 
                RowBox[{"kB", " ", "Tnu"}], ")"}], "4"], 
              RowBox[{"2", 
               SuperscriptBox["\[Pi]", "2"], 
               SuperscriptBox["hbar", "3"], " ", 
               SuperscriptBox["clight", "5"]}]], 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"Inty3MuDistortion", "[", 
                RowBox[{"\[Xi]\[Nu]", ",", "\[CapitalDelta]\[Xi]\[Nu]"}], 
                "]"}], "+", 
               RowBox[{"YSZ", "*", 
                RowBox[{"Inty3SZdistortion", "[", "\[Xi]\[Nu]", "]"}]}]}], 
              ")"}]}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"zminD", "=", 
            RowBox[{"me", "/", 
             RowBox[{"(", 
              RowBox[{"kB", "*", "Ti"}], ")"}]}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"zmaxD", "=", 
            RowBox[{"me", "/", 
             RowBox[{"(", 
              RowBox[{"kB", "*", "Tf"}], ")"}]}]}], ";"}], ",", 
          "\[IndentingNewLine]", "\t", 
          RowBox[{"(*", " ", 
           RowBox[{"**", "*"}], " ", "*)"}], "\[IndentingNewLine]", "\t", 
          RowBox[{
           RowBox[{"If", "[", 
            RowBox[{"$NEVO", ",", "\[IndentingNewLine]", "        ", 
             RowBox[{
              RowBox[{"If", "[", 
               RowBox[{
               "$NeedNEVODistortions", ",", "\[IndentingNewLine]", "\t", 
                RowBox[{
                 RowBox[{"If", "[", 
                  RowBox[{"$Verbose", ",", 
                   RowBox[{
                    RowBox[{
                    "Print", "[", "\"\<Loading NEVO distortions\>\"", "]"}], 
                    ";"}]}], "]"}], ";", "\[IndentingNewLine]", "\t", 
                 RowBox[{"(*", " ", 
                  RowBox[{
                  "Need", " ", "to", " ", "be", " ", "consistent", " ", 
                   "with", " ", "average", " ", "chemical", " ", 
                   "potential"}], " ", "*)"}], "\[IndentingNewLine]", "\t", 
                 RowBox[{"(*", " ", 
                  RowBox[{
                   RowBox[{
                   "This", " ", "is", " ", "the", " ", "difference", " ", 
                    "between", " ", "the", " ", "distorted", " ", 
                    "spectrum"}], ",", " ", 
                   RowBox[{
                    RowBox[{"and", " ", "the", " ", "Fermi"}], "-", 
                    RowBox[{
                    "Dirac", " ", "spectrum", " ", "at", " ", "the", " ", 
                    SubscriptBox["\[Nu]", "e"], " ", 
                    RowBox[{"temperature", "."}]}]}]}], " ", "*)"}], 
                 "\[IndentingNewLine]", "\t", 
                 RowBox[{"(*", " ", 
                  RowBox[{"We", " ", "recall", " ", "that", " ", "the", " ", 
                   SubscriptBox["\[Nu]", "e"], " ", "temperature", " ", "is", 
                   " ", "defined", " ", "as", " ", "the", " ", "temperature", 
                   " ", "of", " ", "the", " ", "fermion", " ", "gas", " ", 
                   "which", " ", "has", " ", "the", " ", "same", " ", 
                   "energy", " ", 
                   RowBox[{"density", "."}]}], " ", "*)"}], 
                 "\[IndentingNewLine]", "\t", 
                 RowBox[{"(*", " ", 
                  RowBox[{
                   RowBox[{
                   "In", " ", "NEVO", " ", "we", " ", "have", " ", "defined", 
                    " ", "the", " ", "non"}], "-", 
                   RowBox[{
                   "distorted", " ", "spectrum", " ", "as", " ", "a", " ", 
                    "FD", " ", "without", " ", "chemical", " ", "potential", 
                    " ", "hence", " ", "we", " ", "ignore", " ", "\[Phi]", 
                    " ", "here"}]}], " ", "*)"}], "\[IndentingNewLine]", "\t", 
                 RowBox[{
                  RowBox[{"dFDneuRaw", "[", 
                   RowBox[{"en_", ",", "\[Phi]_", ",", "x_", ",", "znu_"}], 
                   "]"}], ":=", 
                  RowBox[{"(", 
                   RowBox[{"Module", "[", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"T\[Gamma]", ",", "xNEV", ",", "y"}], "}"}], ",", 
                    "\[IndentingNewLine]", "\t", 
                    RowBox[{
                    RowBox[{"T\[Gamma]", "=", 
                    RowBox[{
                    RowBox[{"me", "/", "kB"}], "/", "x"}]}], ";", 
                    "\[IndentingNewLine]", "\t", 
                    RowBox[{"xNEV", "=", 
                    RowBox[{
                    RowBox[{"xNEVOofTSafe", "[", "FileNEVOneutrinos", "]"}], 
                    "[", "T\[Gamma]", "]"}]}], ";", "\[IndentingNewLine]", 
                    "\t", 
                    RowBox[{"y", "=", 
                    RowBox[{"en", "*", "xNEV"}]}], ";", "\[IndentingNewLine]",
                     "\t", 
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"y", ">=", "ymin"}], "&&", 
                    RowBox[{"y", "<=", "ymax"}]}], ",", "\[IndentingNewLine]", 
                    RowBox[{
                    FractionBox[
                    RowBox[{"(", 
                    RowBox[{"1", "+", 
                    RowBox[{
                    RowBox[{"dfNuexy", "[", "FileNEVOneutrinos", "]"}], "[", 
                    RowBox[{"xNEV", ",", "y"}], "]"}]}], ")"}], 
                    RowBox[{
                    RowBox[{"Exp", "[", "y", "]"}], "+", "1"}]], "-", 
                    FractionBox["1", 
                    RowBox[{
                    RowBox[{"Exp", "[", 
                    RowBox[{"en", "*", "znu"}], "]"}], "+", "1"}]]}], ",", 
                    "0"}], "]"}]}]}], "]"}], "\[IndentingNewLine]", "\t", 
                   ")"}]}], ";", "\[IndentingNewLine]", "\t", 
                 RowBox[{
                  RowBox[{"dFDantineuRaw", "[", 
                   RowBox[{"en_", ",", "\[Phi]_", ",", "x_", ",", "znu_"}], 
                   "]"}], ":=", 
                  RowBox[{"(", 
                   RowBox[{"Module", "[", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"T\[Gamma]", ",", "xNEV", ",", "y"}], "}"}], ",", 
                    "\[IndentingNewLine]", "\t", 
                    RowBox[{
                    RowBox[{"T\[Gamma]", "=", 
                    RowBox[{
                    RowBox[{"me", "/", "kB"}], "/", "x"}]}], ";", 
                    "\[IndentingNewLine]", "\t", 
                    RowBox[{"xNEV", "=", 
                    RowBox[{
                    RowBox[{
                    "xNEVOofTSafe", "[", "FileNEVOantineutrinos", "]"}], "[", 
                    "T\[Gamma]", "]"}]}], ";", "\[IndentingNewLine]", "\t", 
                    RowBox[{"y", "=", 
                    RowBox[{"en", "*", "xNEV"}]}], ";", "\[IndentingNewLine]",
                     "\t", 
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"y", ">=", "ymin"}], "&&", 
                    RowBox[{"y", "<=", "ymax"}]}], ",", "\[IndentingNewLine]",
                     "\t", 
                    RowBox[{
                    FractionBox[
                    RowBox[{"(", 
                    RowBox[{"1", "+", 
                    RowBox[{
                    RowBox[{"dfNuexy", "[", "FileNEVOantineutrinos", "]"}], 
                    "[", 
                    RowBox[{"xNEV", ",", "y"}], "]"}]}], ")"}], 
                    RowBox[{
                    RowBox[{"Exp", "[", "y", "]"}], "+", "1"}]], "-", 
                    FractionBox["1", 
                    RowBox[{
                    RowBox[{"Exp", "[", 
                    RowBox[{"en", "*", "znu"}], "]"}], "+", "1"}]]}], ",", 
                    "0"}], "]"}]}]}], "]"}], "\[IndentingNewLine]", "\t", 
                   ")"}]}], ";"}]}], "]"}], ";", "\[IndentingNewLine]", "\t", 
              
              RowBox[{"(*", " ", 
               RowBox[{
                RowBox[{"When", " ", "using", " ", "NEVO"}], ",", " ", 
                RowBox[{
                "the", " ", "energy", " ", "density", " ", "of", " ", 
                 "distortions", " ", "is", " ", "0", " ", "by", " ", 
                 "construction", " ", 
                 RowBox[{"(", 
                  RowBox[{
                  "choice", " ", "of", " ", "the", " ", "reference", " ", 
                   "temperature"}], ")"}]}]}], "*)"}], "\[IndentingNewLine]", 
              "\t", 
              RowBox[{
               RowBox[{"\[Rho]\[Nu]SD", "[", "Tnu_", "]"}], ":=", "0"}], ";", 
              "\[IndentingNewLine]", "         ", 
              RowBox[{"zminD", "=", 
               RowBox[{"me", "/", 
                RowBox[{"(", 
                 RowBox[{"kB", "*", 
                  RowBox[{"T\[Gamma]max", "[", "FileNEVOneutrinos", "]"}]}], 
                 ")"}]}]}], ";", "\[IndentingNewLine]", "        ", 
              RowBox[{"zmaxD", "=", 
               RowBox[{"me", "/", 
                RowBox[{"(", 
                 RowBox[{"kB", "*", 
                  RowBox[{"T\[Gamma]min", "[", "FileNEVOneutrinos", "]"}]}], 
                 ")"}]}]}], ";"}]}], "\[IndentingNewLine]", "\t", "]"}], 
           ";"}]}], "\[IndentingNewLine]", "\t", "]"}], ";", 
        "\[IndentingNewLine]", "\t", "\[IndentingNewLine]", 
        "\[IndentingNewLine]", 
        RowBox[{"Clear", "[", "dFDneu", "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{
          RowBox[{
          "The", " ", "negative", " ", "energy", " ", "corresponds", " ", 
           "to", " ", "Pauli", " ", "Blocking", " ", "factors"}], ",", " ", 
          RowBox[{
          "hence", " ", "the", " ", "extra", " ", "minus", " ", "sign"}]}], 
         "*)"}], "\n", "            ", 
        RowBox[{"(*", " ", 
         RowBox[{
         "We", " ", "also", " ", "treat", " ", "the", " ", "cases", " ", 
          "which", " ", "are", " ", "outside", " ", "the", " ", "grid", " ", 
          "of", " ", "interpolations", " ", "using", " ", "that", " ", 
          "spectra", " ", "are", " ", "frozen", " ", "once", " ", 
          "decoupled"}], " ", "*)"}], "\[IndentingNewLine]", " ", 
        RowBox[{
         RowBox[{"dFDneu", "[", 
          RowBox[{
           RowBox[{"en_", "?", "NumericQ"}], ",", "\[Phi]_", ",", "x_", ",", 
           "znu_", ",", "sgnq_"}], "]"}], ":=", 
         RowBox[{
          RowBox[{"dFDneuRaw", "[", 
           RowBox[{"en", ",", "\[Phi]", ",", "x", ",", "znu"}], "]"}], "/;", 
          RowBox[{
           RowBox[{"en", "\[GreaterEqual]", "0"}], "&&", 
           RowBox[{"sgnq", ">", "0"}], "&&", 
           RowBox[{"x", ">=", "zminD"}], "&&", 
           RowBox[{"x", "<=", "zmaxD"}]}]}]}], ";", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{
          "Neutrinos", " ", "on", " ", "the", " ", "initial", " ", "state", 
           " ", "in", " ", "n"}], "->", 
          RowBox[{"p", " ", "reactions"}]}], "*)"}], "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"dFDneu", "[", 
          RowBox[{
           RowBox[{"en_", "?", "NumericQ"}], ",", "\[Phi]_", ",", "x_", ",", 
           "znu_", ",", "sgnq_"}], "]"}], ":=", 
         RowBox[{
          RowBox[{"dFDantineuRaw", "[", 
           RowBox[{"en", ",", "\[Phi]", ",", "x", ",", "znu"}], "]"}], "/;", 
          RowBox[{
           RowBox[{"en", "\[GreaterEqual]", "0"}], "&&", 
           RowBox[{"sgnq", "<", "0"}], "&&", 
           RowBox[{"x", ">=", "zminD"}], "&&", 
           RowBox[{"x", "<=", "zmaxD"}]}]}]}], ";", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{
          "AntiNeutrinos", " ", "on", " ", "the", " ", "initial", " ", 
           "state", " ", "in", " ", "p"}], "->", 
          RowBox[{"n", " ", "reactions"}]}], "*)"}], "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"dFDneu", "[", 
          RowBox[{
           RowBox[{"en_", "?", "NumericQ"}], ",", "\[Phi]_", ",", "x_", ",", 
           "znu_", ",", "sgnq_"}], "]"}], ":=", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{"dFDantineuRaw", "[", 
            RowBox[{
             RowBox[{"-", "en"}], ",", "\[Phi]", ",", "x", ",", "znu"}], 
            "]"}]}], "/;", 
          RowBox[{
           RowBox[{"en", "<", "0"}], "&&", 
           RowBox[{"sgnq", ">", "0"}], "&&", 
           RowBox[{"x", ">=", "zminD"}], "&&", 
           RowBox[{"x", "<=", "zmaxD"}]}]}]}], ";", 
        RowBox[{"(*", 
         RowBox[{
         "Corresponds", " ", "to", " ", "antineutrinos", " ", "blocking", " ", 
          RowBox[{"factor", "."}]}], "*)"}], "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"dFDneu", "[", 
          RowBox[{
           RowBox[{"en_", "?", "NumericQ"}], ",", "\[Phi]_", ",", "x_", ",", 
           "znu_", ",", "sgnq_"}], "]"}], ":=", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{"dFDneuRaw", "[", 
            RowBox[{
             RowBox[{"-", "en"}], ",", "\[Phi]", ",", "x", ",", "znu"}], 
            "]"}]}], "/;", 
          RowBox[{
           RowBox[{"en", "<", "0"}], "&&", 
           RowBox[{"sgnq", "<", "0"}], "&&", 
           RowBox[{"x", ">=", "zminD"}], "&&", 
           RowBox[{"x", "<=", "zmaxD"}]}]}]}], ";", 
        RowBox[{"(*", 
         RowBox[{
         "Corresponds", " ", "to", " ", "neutrinos", " ", "blocking", " ", 
          RowBox[{"factor", "."}]}], "*)"}], "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"dFDneu", "[", 
          RowBox[{
           RowBox[{"en_", "?", "NumericQ"}], ",", "\[Phi]_", ",", "x_", ",", 
           "znu_", ",", "sgnq_"}], "]"}], ":=", 
         RowBox[{"0", "/;", 
          RowBox[{
           RowBox[{"x", "<", "zminD"}], "||", 
           RowBox[{"x", ">", "zmaxD"}]}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"SetAttributes", "[", 
         RowBox[{"dFDneu", ",", "Listable"}], "]"}], ";"}]}], 
      "\[IndentingNewLine]", "]"}], ";"}], ")"}]}], ";"}]], "Input",
