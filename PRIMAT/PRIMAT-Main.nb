 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["10", "11"], "K"}], TraditionalForm]],ExpressionUUID->
  "9d66696f-3c65-4bfa-9134-046b54b5e201"],
 " to ",
