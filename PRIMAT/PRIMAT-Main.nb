          RowBox[{
           RowBox[{"tv", "[", 
            RowBox[{"a", "[", "Ti", "]"}], "]"}], "\[Equal]", 
           FractionBox["1", 
            RowBox[{"(", 
             RowBox[{"2", 
              RowBox[{"H", "[", 
               RowBox[{"a", "[", "Ti", "]"}], "]"}]}], ")"}]]}]}], "}"}], ",",
         "tv", ",", 
        RowBox[{"{", 
         RowBox[{"av", ",", 
          RowBox[{"a", "[", "Ti", "]"}], ",", 
          RowBox[{"a", "[", "Tf", "]"}]}], "}"}], ",", 
        RowBox[{"PrecisionGoal", "\[Rule]", "8"}], ",", 
        RowBox[{"AccuracyGoal", "\[Rule]", "10"}]}], "]"}], ")"}]}], ";"}], 
