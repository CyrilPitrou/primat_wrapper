Cell[TextData[{
 "The Friedmann equation gives the Hubble expansion rate. \nFor completeness \
we put baryons and CDM even though it makes a difference of order ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["10", 
     RowBox[{"-", "5"}]], " "}], TraditionalForm]],ExpressionUUID->
  "437c4b11-4ffa-4b81-93a1-9738d2f07ab5"],
 "which is below what we can achieve anyway with homogeneous computations."
}], "Text",
 InitializationCell->
  True,ExpressionUUID->"04a5b270-48d5-4316-9e0c-285e2e1d2a61"],

Cell[BoxData[
 RowBox[{
  SuperscriptBox["H", "2"], "=", 
  RowBox[{
   FractionBox[
    RowBox[{"8", "\[Pi]", " ", "G", " ", "\[Rho]"}], "3"], "=", 
   RowBox[{
    FractionBox["\[Rho]", 
     SubscriptBox["\[Rho]", "crit"]], " ", "so", " ", "we", " ", "build", " ",
     "first", " ", "the", " ", "energy", " ", 
    RowBox[{"density", "."}]}]}]}]], "Text",
 InitializationCell->True,
 CellChangeTimes->{{3.693925459085713*^9, 3.6939254840692787`*^9}, {
   3.698566073729411*^9, 3.698566080628306*^9}, 3.698734663166689*^9, {
   3.7191660876094522`*^9, 3.7191661058145447`*^9}},
 FontFamily->"Arial",ExpressionUUID->"549cf7ab-0301-46c3-abda-1c5b62b60f3f"],

Cell["\<\
We select the neutrino energy density depending on options for decoupling\
\>", "Text",
 CellChangeTimes->{{3.719209391357827*^9, 3.719209407019197*^9}, {
  3.7192094882363873`*^9, 
  3.719209490483878*^9}},ExpressionUUID->"c4206ac1-8525-4d39-b01e-\
41ca7d74de3e"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"\[Rho]\[Nu]", "[", "T_", "]"}], ":=", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{"$IncompleteNeutrinoDecoupling", ",", 
      RowBox[{"\[Rho]\[Nu]IncompleteDecoupling", "[", 
       RowBox[{"a", "[", "T", "]"}], "]"}], ",", 
      RowBox[{"\[Rho]\[Nu]Decoupling", "[", "T", "]"}]}], "]"}], "+", 
    RowBox[{"If", "[", 
     RowBox[{"$SpectralDistortions", ",", 
      RowBox[{"\[Rho]\[Nu]SD", "[", 
       RowBox[{
        RowBox[{"T\[Nu]overT", "[", "T", "]"}], "*", "T"}], "]"}], ",", "0"}],
      "]"}]}]}], ";"}]], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.719209411490049*^9, 3.719209448773353*^9}, {
   3.720270301598461*^9, 3.720270310154229*^9}, {3.935033306612378*^9, 
   3.935033324358797*^9}, {3.9350333675610447`*^9, 3.935033369322021*^9}, {
   3.9350362307439203`*^9, 3.935036231026937*^9}, 3.935037860524806*^9, {
   3.935112628231324*^9, 3.935112636788739*^9}, 3.935113243669076*^9},
 CellLabel->
  "In[416]:=",ExpressionUUID->"043f1be7-2ada-4f70-905e-df4f05ce0247"],

Cell["If relativistic species added, we must also add them", "Text",
 CellChangeTimes->{{3.935114342077223*^9, 
  3.935114357840775*^9}},ExpressionUUID->"789bcdaa-2cc3-4598-b4c5-\
884a2a91d87c"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"\[Rho]\[Nu]Relat", "[", "Tv_", "]"}], ":=", 
    RowBox[{"aBB", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"kB", " ", 
        RowBox[{"T\[Nu]overTDecoupling", "[", "Tv", "]"}], "Tv"}], ")"}], 
      "4"], " ", 
     FractionBox["7", "8"], " ", "*", "Nrelat"}]}], ";"}], 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"T\[Nu]", " ", "~", "1"}], "/", "a"}], " ", "exactly", " ", "in",
     " ", "the", " ", "decoupling", " ", "limit", " ", "hence", " ", "this", 
    " ", "corresponds", " ", "to", " ", "the", " ", "temperature", " ", "of", 
    " ", "an", " ", "unkown", " ", "relativistic", " ", "but", " ", 
    "decoupled", " ", "species"}], " ", "*)"}]}]], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.935116257014093*^9, 3.935116273140471*^9}},
 CellLabel->
  "In[417]:=",ExpressionUUID->"021efc18-0043-4e9d-a576-6da31072ee40"],

Cell[TextData[StyleBox["EDE energy density",
 FontColor->RGBColor[1, 0, 0]]], "Text",
 CellChangeTimes->{{3.988772403931116*^9, 3.988772424584168*^9}, {
  3.988772720954171*^9, 
  3.988772724354549*^9}},ExpressionUUID->"61948407-6e24-4a6b-85ed-\
a5bc224d851b"],

Cell[BoxData[{
 RowBox[{"aEDEmax", " ", ":=", 
  RowBox[{"acEDE", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"4", "/", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"3", " ", "wnEDE"}], "-", "1"}], ")"}]}], ")"}], "^", 
    RowBox[{"(", 
     RowBox[{"1", "/", 
      RowBox[{"(", 
       RowBox[{"3", 
        RowBox[{"(", 
         RowBox[{"1", "+", "wnEDE"}], ")"}]}], ")"}]}], 
     ")"}]}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Rho]radamax", ":=", 
   RowBox[{
    RowBox[{
     RowBox[{"aBB", " ", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"kB", " ", "Tv"}], ")"}], "4"], 
      RowBox[{"(", 
       RowBox[{"1", "+", 
        RowBox[{"D\[Rho]T", "[", "Tv", "]"}]}], ")"}]}], "+", 
     RowBox[{"\[Rho]\[Nu]", "[", "Tv", "]"}], "+", 
     RowBox[{"\[Rho]\[Nu]Relat", "[", "Tv", "]"}]}], "/.", 
    RowBox[{"Tv", "->", 
     RowBox[{"Tofa", "[", "aEDEmax", "]"}]}]}]}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"\[Rho]radac", ":=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       SubscriptBox["\[CapitalOmega]", "\[Nu]0"], "+", 
       SubscriptBox["\[CapitalOmega]", "\[Gamma]0"]}], ")"}], 
     RowBox[{
      SubscriptBox["\[Rho]", "crit"], "/", 
      RowBox[{"aEDEmax", "^", "4"}]}]}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{"\[Rho]EDEac", ":=", 
  RowBox[{
   RowBox[{"fEDE", "/", 
    RowBox[{"(", 
     RowBox[{"1", "-", "fEDE"}], ")"}]}], 
   RowBox[{"\[Rho]radamax", "/", "2"}], 
   RowBox[{"(", 
    RowBox[{"1", "+", 
     RowBox[{"4", "/", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"3", "wnEDE"}], "-", "1"}], ")"}]}]}], 
    ")"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Rho]EDE", "[", "av_", "]"}], ":=", 
  RowBox[{"2", 
   RowBox[{"\[Rho]EDEac", "/", 
    RowBox[{"(", 
     RowBox[{"1", "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"av", "/", "acEDE"}], ")"}], "^", 
       RowBox[{"(", 
        RowBox[{"3", 
         RowBox[{"(", 
          RowBox[{"1", "+", "wnEDE"}], ")"}]}], ")"}]}]}], 
     ")"}]}]}]}]}], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.988436266895852*^9, 3.988436316100876*^9}, {
  3.9884364265657797`*^9, 3.9884364978003798`*^9}, {3.988436556436582*^9, 
  3.988436584929058*^9}, {3.98843902938171*^9, 3.988439045991251*^9}, {
  3.988772289382004*^9, 3.9887723533057823`*^9}, {3.9887727762793694`*^9, 
