ab5b473b78ff"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"DYOnlyPEN", "[", 
     RowBox[{"Temp_", ",", "\[Rho]B_", ",", "time_"}], "]"}], ":=", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"(", "FormalReactionsOnlyPEN", ")"}], "/.", 
        RowBox[{"Dispatch", "@", 
         RowBox[{"Rules\[Lambda]", "[", "Temp", "]"}]}]}], "/.", 
       RowBox[{"Dispatch", "@", 
        RowBox[{"Rules\[Lambda]bar", "[", "Temp", "]"}]}]}], "/.", 
      RowBox[{"Dispatch", "@", 
       RowBox[{"RulesY", "[", "time", "]"}]}]}], "/.", 
     RowBox[{"A\[Rho]B", "\[Rule]", "\[Rho]B"}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"DY18", "[", 
