  3.936616775467257*^9}},ExpressionUUID->"93145db7-35ca-4c91-acc2-\
14da61dd1be2"],

Cell["\<\
Hubble function from Friedmann equation in flat FL space-time is then \
immediate\
\>", "Text",
 InitializationCell->True,
 CellChangeTimes->{{3.6983861154343643`*^9, 3.698386131195938*^9}, {
  3.715951915727253*^9, 
  3.715951920159058*^9}},ExpressionUUID->"0e80e600-648f-4c90-98ba-\
4dfe8c05c02d"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"HofT", "[", "T_", "]"}], ":=", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       FractionBox[
        RowBox[{"8", "\[Pi]", " ", "GN"}], "3"], 
       RowBox[{"\[Rho]tot", "[", "T", "]"}]}], ")"}], 
     RowBox[{"(", 
      RowBox[{"1", "/", "2"}], ")"}]]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"H", "[", "a_", "]"}], ":=", 
    RowBox[{"HofT", "[", 
     RowBox[{"Tofa", "[", "a", "]"}], "]"}]}], ";"}], 
  RowBox[{"(*", 
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       FractionBox[
        RowBox[{"8", "\[Pi]", " ", "GN"}], "3"], 
