Cell["Some checks of analytics :", "Text",
 CellChangeTimes->{{3.98843696199654*^9, 
  3.9884369693090754`*^9}},ExpressionUUID->"80f2bdbd-ef68-47cd-ad05-\
52bee4a77c0d"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"\[Rho]EDEt", "[", "a_", "]"}], ":=", 
   RowBox[{"\[Rho]EDE0", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", "+", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"a0", "/", "ac"}], ")"}], "^", 
        RowBox[{"(", 
         RowBox[{"3", 
          RowBox[{"(", 
           RowBox[{"1", "+", "wn"}], ")"}]}], ")"}]}]}], ")"}], "/", 
     RowBox[{"(", 
      RowBox[{"1", "+", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"a", "/", "ac"}], ")"}], "^", 
        RowBox[{"(", 
         RowBox[{"3", 
          RowBox[{"(", 
           RowBox[{"1", "+", "wn"}], ")"}]}], ")"}]}]}], ")"}]}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"\[Rho]\[Gamma]t", "[", "a_", "]"}], ":=", 
    RowBox[{"\[Rho]0", "*", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"a0", "/", "a"}], ")"}], "^", "4"}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{"Exp", "[", 
    RowBox[{"-", 
     RowBox[{"Integrate", "[", 
      RowBox[{
       RowBox[{"3", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"1", "+", "wn"}], ")"}], "/", "a"}], "/", 
         RowBox[{"(", 
          RowBox[{"1", "+", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"ac", "/", "a"}], ")"}], "^", 
            RowBox[{"(", 
             RowBox[{"3", 
              RowBox[{"(", 
               RowBox[{"1", "+", "wn"}], ")"}]}], ")"}]}]}], ")"}]}]}], ",", 
       "a"}], "]"}]}], "]"}], ",", 
   RowBox[{"Assumptions", "->", 
    RowBox[{
     RowBox[{"ac", ">", "0"}], "&&", 
     RowBox[{"a", ">", "0"}]}]}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.9884345106921177`*^9, 3.988434579880671*^9}, {
  3.9884369728536453`*^9, 3.988436979240974*^9}, {3.98843759027092*^9, 
  3.9884375923584557`*^9}, {3.9888910254180527`*^9, 3.9888910267495213`*^9}},
 CellLabel->
