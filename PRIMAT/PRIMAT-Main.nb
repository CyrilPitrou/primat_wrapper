          RowBox[{"{", 
           RowBox[{"e1me2", ",", 
            RowBox[{"-", 
             RowBox[{"Max", "[", 
              RowBox[{"10", ",", 
               RowBox[{"15", "/", "x"}]}], "]"}]}], ",", 
            RowBox[{"-", "0.001"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"e1pe2", ",", 
            RowBox[{"2.001", "+", 
             RowBox[{"Abs", "[", "e1me2", "]"}]}], ",", 
            RowBox[{"2", "+", 
             RowBox[{"Abs", "[", "e1me2", "]"}], "+", 
             RowBox[{"Max", "[", 
              RowBox[{"10", ",", 
               RowBox[{"15", "/", "x"}]}], "]"}]}]}], "}"}], ",", 
          RowBox[{"PrecisionGoal", "\[Rule]", "3"}]}], "]"}], 
        "\[IndentingNewLine]", "+", 
        RowBox[{"NIntegrate", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"1", "/", "2"}], 
           RowBox[{"C2dE1dE2CN", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"(", 
