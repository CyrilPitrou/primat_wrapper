 RowBox[{
  RowBox[{"$BDFOrder", "=", "2"}], ";"}]], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.93689716052355*^9, 3.936897161776414*^9}, {
  3.936898242993013*^9, 3.936898243045601*^9}},
 CellLabel->
