Cell[BoxData[
 RowBox[{
  RowBox[{"LoadRates", ":=", 
   RowBox[{"(", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Off", "[", 
      StyleBox[
       RowBox[{"General", "::", "munfl"}], "MessageName"], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "The", " ", "list", " ", "fo", " ", "reactions", " ", "which", " ", 
       "are", " ", "tabulated", " ", "in", " ", 
       RowBox[{"external", " ", ".", "dat"}], " ", "file"}], "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"ListReactionsFile", "=", 
      RowBox[{"TreatReactionLine", "/@", "ReshapedTabulatedReactions"}]}], 
     ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "The", " ", "list", " ", "of", " ", "reactions", " ", "defined", " ", 
       "analytically"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"Not", "[", "$ReducedNetwork", "]"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"ExtraAnalyticReactions", "=", "DefineAnalyticRates"}], ";"}],
        ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"ExtraAnalyticReactions", "=", 
         RowBox[{"{", "}"}]}], ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{
       "We", " ", "concatenate", " ", "the", " ", "weak", " ", "reactions"}], 
       ",", " ", 
       RowBox[{
       "the", " ", "tabulated", " ", "rates", " ", "and", " ", "the", " ", 
        "analytic", " ", "rates"}]}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{"ListReactions", "=", 
      RowBox[{"Join", "[", 
       RowBox[{
        RowBox[{"{", "ReactionPEN", "}"}], ",", "ListReactionsFile", ",", 
        "ExtraAnalyticReactions"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"ListReactionsUpToChosenMass", "=", 
      RowBox[{"ListReactionsUpToMass", "[", 
       RowBox[{"MaximumNuclearMass", ",", "ListReactions"}], "]"}]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"On", "[", 
      StyleBox[
       RowBox[{"General", "::", "munfl"}], "MessageName"], "]"}], ";"}], 
    "\[IndentingNewLine]", ")"}]}], ";"}]], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.936253734900084*^9, 3.936253754122294*^9}, {
