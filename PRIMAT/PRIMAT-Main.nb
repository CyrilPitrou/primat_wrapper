Cell["\<\
From excess masses we can find binding energies (in keV). WE only need the \
excess mass of proton and neutron and the (Z,A,N) of the nuclide.\
\>", "Text",
 CellChangeTimes->{{3.717580836444929*^9, 3.717580846940195*^9}, {
  3.717581235962739*^9, 3.717581239216831*^9}, {3.722697547516692*^9, 
  3.722697561826241*^9}},ExpressionUUID->"3c4a522a-1d03-48a1-8851-\
8c776328bd45"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Eneutron", ":=", 
   RowBox[{"ExcessMassKeys", "[", "\"\<n\>\"", "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Eproton", ":=", 
   RowBox[{"ExcessMassKeys", "[", "\"\<p\>\"", "]"}]}], ";"}]}], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.717504016307132*^9, 3.717504039530407*^9}, {
  3.7175808547457533`*^9, 3.717580855732171*^9}, {3.717580952152384*^9, 
  3.71758095330501*^9}, {3.71767707075093*^9, 3.717677072223783*^9}},
 CellLabel->
  "In[678]:=",ExpressionUUID->"f4bb4f14-449f-42bd-98cb-7057f8489f67"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"BindingEnergy", "[", "name_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"Pair", ",", "A", ",", "Z", ",", "N"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Pair", "=", 
       RowBox[{"KeySpecies", "[", "name", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Z", "=", 
       RowBox[{"Pair", "[", 
        RowBox[{"[", "2", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"N", "=", 
       RowBox[{"Pair", "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"A", "=", 
       RowBox[{"Z", "+", "N"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"N", " ", "Eneutron"}], " ", "+", 
       RowBox[{"Z", " ", "Eproton"}], "-", 
       RowBox[{"ExcessMassKeys", "[", "name", "]"}]}]}]}], "]"}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Mass", "[", "name_", "]"}], ":=", 
  RowBox[{"Module", "[", 
