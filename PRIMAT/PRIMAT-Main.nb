Cell["\<\
We can also perform a fit in Hermite polynomials of the NEVO heating \
function. Just for information. \
\>", "Text",ExpressionUUID->"93dafe56-baa9-41fa-865c-d1077bfb4633"],

Cell[BoxData[
 RowBox[{
  RowBox[{"If", "[", 
   RowBox[{"$NEVO", ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"Nlz", "[", "lz_", "]"}], ":=", 
      RowBox[{
       RowBox[{"\[ScriptCapitalN]NEVO", "[", "FileNEVOneutrinos", "]"}], "[", 
       
       RowBox[{"Exp", "@", "lz"}], "]"}]}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"Gram", "-", 
       RowBox[{"Charlier", " ", 
        RowBox[{"expansion", ".", " ", "Works"}], " ", "better", " ", "in", 
        " ", "that", " ", "case"}]}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"MyHermiteN", "[", 
       RowBox[{"n_", ",", "x_"}], "]"}], ":=", 
      RowBox[{"Expand", "@", 
       RowBox[{"Simplify", "[", 
        RowBox[{
         RowBox[{"HermiteH", "[", 
          RowBox[{"n", ",", 
           RowBox[{"x", "/", 
            RowBox[{"Sqrt", "[", "2", "]"}]}]}], "]"}], "/", 
         RowBox[{
          RowBox[{"Sqrt", "[", "2", "]"}], "^", "n"}]}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", "\n", 
     RowBox[{"Fitfun", "=", 
      RowBox[{
       RowBox[{"A", "/", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Sqrt", "[", 
           RowBox[{"2", "Pi"}], "]"}], "\[Sigma]"}], ")"}]}], 
       RowBox[{"Exp", "[", 
        RowBox[{
         RowBox[{"-", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"lz", "-", "\[Mu]"}], ")"}], "^", "2"}]}], "/", 
         RowBox[{"(", 
          RowBox[{"2", 
           RowBox[{"\[Sigma]", "^", "2"}]}], ")"}]}], "]"}], 
       RowBox[{"(", 
        RowBox[{"1", "\[IndentingNewLine]", "+", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"S3", "/", 
            RowBox[{"3", "!"}]}], 
           RowBox[{"MyHermiteN", "[", 
            RowBox[{"3", ",", " ", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"lz", "-", "\[Mu]"}], ")"}], "/", "\[Sigma]"}]}], 
            "]"}]}], ")"}], "\[IndentingNewLine]", "+", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"S4", "/", 
            RowBox[{"4", "!"}]}], 
           RowBox[{"MyHermiteN", "[", 
            RowBox[{"4", ",", " ", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"lz", "-", "\[Mu]"}], ")"}], "/", "\[Sigma]"}]}], 
            "]"}]}], ")"}], "\[IndentingNewLine]", "+", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"S5", "/", 
            RowBox[{"5", "!"}]}], " ", 
           RowBox[{"MyHermiteN", "[", 
            RowBox[{"5", ",", " ", 
             RowBox[{
              RowBox[{"(", 
