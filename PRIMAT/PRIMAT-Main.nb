          RowBox[{"$TnuEqualT", ",", "x", ",", "znu"}], "]"}], ",", "1"}], 
        "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"en", ",", "1.001", ",", 
         RowBox[{"Max", "[", 
          RowBox[{"10", ",", 
           RowBox[{"20", "/", "x"}]}], "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"k", ",", "0.001", ",", 
         RowBox[{"Abs", "[", 
          RowBox[{"en", "-", "q"}], "]"}], ",", 
         RowBox[{"Abs", "[", 
          RowBox[{"en", "+", "q"}], "]"}], ",", 
         RowBox[{"Max", "[", 
          RowBox[{"10", ",", 
           RowBox[{"20", "/", "x"}]}], "]"}]}], "}"}], ",", 
       RowBox[{"PrecisionGoal", "\[Rule]", "4"}]}], "]"}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}]}], "Input",
