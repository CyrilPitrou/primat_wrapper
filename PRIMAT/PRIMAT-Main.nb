            RowBox[{"-", "1"}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"en", ",", "1", ",", 
            RowBox[{"Max", "[", 
             RowBox[{"25", ",", 
              RowBox[{"150", "/", "x"}]}], "]"}]}], "}"}]}], "]"}], 
        "\[IndentingNewLine]", "+", 
        RowBox[{"NIntegrate", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"1", "/", "2"}], 
