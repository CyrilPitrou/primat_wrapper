Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"dPe3", "[", "T_", "]"}], ":=", 
   RowBox[{
    RowBox[{"dPe3", "[", "T", "]"}], "=", 
    RowBox[{
     RowBox[{
      RowBox[{"(", "\[Alpha]FS", ")"}], "^", 
      RowBox[{"(", 
       RowBox[{"3", "/", "2"}], ")"}]}], "*", 
     RowBox[{"(", 
      RowBox[{"4", "/", "3"}], ")"}], 
     RowBox[{"Sqrt", "[", 
      RowBox[{"2", "Pi"}], "]"}], 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"kB", " ", "T"}], ")"}], "4"], 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"ImnT", "[", "1", "]"}], "[", 
            RowBox[{"0", ",", "1"}], "]"}], "[", "T", "]"}], "+", 
          RowBox[{
           RowBox[{
            RowBox[{"ImnT", "[", "1", "]"}], "[", 
            RowBox[{"2", ",", 
             RowBox[{"-", "1"}]}], "]"}], "[", "T", "]"}]}], ")"}], "/", 
        RowBox[{"Pi", "^", "2"}]}], ")"}], "^", 
      RowBox[{"(", 
       RowBox[{"3", "/", "2"}], ")"}]}]}]}]}], ";"}]], "Input",
 InitializationCell->True,
 CellLabel->
  "In[279]:=",ExpressionUUID->"7f72c194-3b5d-4716-a2df-d302045bc71c"],

