Cell[CellGroupData[{

Cell["Spectral distortions of neutrino spectrum", "Section",
 CellChangeTimes->{{3.782814330952732*^9, 
  3.782814345005127*^9}},ExpressionUUID->"9598c05e-1bcc-4173-a1d2-\
b631f3b9c01a"],

Cell["\<\
Shift in the weak rates due to spectral distortions of neutrino distribution \
functions.\
\>", "Text",
 CellChangeTimes->{{3.7828143940794353`*^9, 
  3.78281441344271*^9}},ExpressionUUID->"6ef6f2fc-a095-4fbf-a419-\
fec43900dcd4"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"\[Delta]\[Chi]", "[", 
    RowBox[{"en_", ",", "pe_", ",", "x_", ",", "znu_", ",", "sgnq_"}], "]"}], 
   ":=", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"q", "=", 
       RowBox[{"Q", "/", "me"}]}], " ", "}"}], ",", 
     RowBox[{
      RowBox[{"dFDneu", "[", 
       RowBox[{
        RowBox[{"en", "-", 
         RowBox[{"sgnq", " ", "q"}]}], ",", 
        RowBox[{"sgnq", " ", "\[Xi]\[Nu]"}], ",", "x", ",", "znu", ",", 
        "sgnq"}], "]"}], 
      RowBox[{"FD", "[", 
       RowBox[{
        RowBox[{"-", "en"}], ",", "x"}], "]"}], 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"en", "-", 
         RowBox[{"sgnq", " ", "q"}]}], ")"}], "2"]}]}], "]"}]}], 
  ";"}]], "Input",
 InitializationCell->True,
 CellChangeTimes->{3.9349653120679913`*^9},
 CellLabel->
  "In[527]:=",ExpressionUUID->"7d1a7b18-031c-44b6-ae0f-77892793459d"],

Cell["\<\
We add this spectral distortions effect at the Born approximation level.\
\>", "Text",
 CellChangeTimes->{{3.782814446023917*^9, 
  3.782814482330453*^9}},ExpressionUUID->"84fc9bd3-1901-4f4a-be54-\
8f6f1f9c4b6a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "Spectral", " ", "distortions", " ", "with", " ", "Born", " ", 
    "approximation"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"IPENdpSD", "[", 
     RowBox[{"pe_", ",", "x_", ",", "znu_", ",", "sgnq_"}], "]"}], ":=", 
    RowBox[{"IPENdpFrom\[Chi]NoCCR", "[", 
     RowBox[{
      RowBox[{"enOFpe", "[", 
       RowBox[{"pe", ",", "x"}], "]"}], ",", "pe", ",", "x", ",", 
      RowBox[{"If", "[", 
       RowBox[{"$TnuEqualT", ",", "x", ",", "znu"}], "]"}], ",", "sgnq", ",", 
      "\[Delta]\[Chi]"}], "]"}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"IPENdpSDCCR", "[", 
     RowBox[{"pe_", ",", "x_", ",", "znu_", ",", "sgnq_"}], "]"}], ":=", 
    RowBox[{"IPENdpFrom\[Chi]CCR", "[", 
     RowBox[{
      RowBox[{"enOFpe", "[", 
       RowBox[{"pe", ",", "x"}], "]"}], ",", "pe", ",", "x", ",", 
      RowBox[{"If", "[", 
       RowBox[{"$TnuEqualT", ",", "x", ",", "znu"}], "]"}], ",", "sgnq", ",", 
      "\[Delta]\[Chi]"}], "]"}]}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"\[Lambda]nTOpSD", "[", "Tv_", "]"}], ":=", 
     RowBox[{"IntegrateRatedp", "[", 
      RowBox[{"IPENdpSD", ",", "1", ",", "Tv"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"\[Lambda]pTOnSD", "[", "Tv_", "]"}], ":=", 
     RowBox[{"IntegrateRatedp", "[", 
      RowBox[{"IPENdpSD", ",", 
       RowBox[{"-", "1"}], ",", "Tv"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"\[Lambda]nTOpSDCCR", "[", "Tv_", "]"}], ":=", 
