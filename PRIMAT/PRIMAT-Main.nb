Cell["\<\
Effect of spectral distortions on the rates : relative variations wrt to the \
rate without them. This plot depends on which spectral distortions have been \
chosen above. If none, it is identically zero.\
\>", "Text",
 CellChangeTimes->{{3.935121600257648*^9, 3.9351216083819857`*^9}, {
  3.93512331175528*^9, 3.935123330695114*^9}, {3.935125185215179*^9, 
  3.93512521948685*^9}},ExpressionUUID->"4affa8ea-700c-4f9e-8e48-\
6c3d3ff55531"],

Cell[BoxData[
 RowBox[{"(*", 
  RowBox[{
   RowBox[{"listT", "=", 
    RowBox[{
     RowBox[{"ListTRange", "[", 
      RowBox[{
       RowBox[{"10", "^", "9"}], ",", 
       RowBox[{"10", "^", "11.5"}]}], "]"}], "[", 
     RowBox[{"[", 
      RowBox[{"1", ";;", " ", ";;", "10"}], "]"}], "]"}]}], ";", 
   RowBox[{"(*", 
    RowBox[{
    "We", " ", "take", " ", "only", " ", "10", "%", " ", "of", " ", "points", 
     " ", "to", " ", "get", " ", "the", " ", "plot", " ", 
     RowBox[{"faster", ".", " ", "Otherwise"}], " ", "it", " ", "takes", " ", 
     "a", " ", "bit", " ", 
     RowBox[{"longer", "."}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"ListLogLinearPlot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"T", ",", 
           RowBox[{
            RowBox[{"\[Lambda]nTOpSDCCR", "[", "T", "]"}], "/", 
            RowBox[{"\[Lambda]nTOpNormalized", "[", "T", "]"}]}]}], "}"}], 
         ",", 
         RowBox[{"{", 
          RowBox[{"T", ",", "listT"}], "}"}]}], "]"}], ",", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"T", ",", 
           RowBox[{
            RowBox[{"\[Lambda]pTOnSDCCR", "[", "T", "]"}], "/", 
            RowBox[{"\[Lambda]pTOnNormalized", "[", "T", "]"}]}]}], "}"}], 
         ",", 
         RowBox[{"{", 
          RowBox[{"T", ",", "listT"}], "}"}]}], "]"}]}], "}"}], ",", 
     RowBox[{"Joined", "\[Rule]", "True"}], ",", 
     RowBox[{"Frame", "\[Rule]", "True"}], ",", 
     RowBox[{"FrameStyle", "\[Rule]", 
      RowBox[{"Thickness", "[", "0.003", "]"}]}], ",", 
     RowBox[{"LabelStyle", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"FontSize", "\[Rule]", "10"}], "}"}]}], ",", 
     RowBox[{"FrameLabel", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{
       "\"\<T (K)\>\"", ",", 
        "\"\<\[Delta]\[CapitalGamma]/\[CapitalGamma]\>\""}], "}"}]}], ",", 
     RowBox[{"PlotStyle", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"Red", ",", 
          RowBox[{"Thickness", "[", "0.003", "]"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"Blue", ",", 
          RowBox[{"Thickness", "[", "0.003", "]"}]}], "}"}]}], "}"}]}]}], 
    "]"}]}], "*)"}]], "Input",
