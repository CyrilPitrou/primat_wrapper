Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "The", " ", "function", " ", "which", " ", "attaches", " ", "it", " ", 
    "to", " ", "the", " ", "one", " ", "we", " ", "want", " ", 
    RowBox[{"(", 
     RowBox[{
     "and", " ", "possibly", " ", "read", " ", "on", " ", "disk", " ", "if", 
