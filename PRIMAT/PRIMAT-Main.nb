        RowBox[{"constants", "[", 
         RowBox[{"[", "3", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Qoverkb", "=", 
        RowBox[{"constants", "[", 
         RowBox[{"[", "4", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{
        "We", " ", "check", " ", "the", " ", "constants", " ", "used", " ", 
         "in", " ", "reverse", " ", "rates"}], " ", "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"InfoFromAudi2017", "=", 
        RowBox[{"InfoReaction", "[", 
         RowBox[{"InitialParticles", ",", "FinalParticles"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"Print", "[", 
          RowBox[{
          "InitialParticles", ",", "\"\< \>\"", ",", "FinalParticles", ",", 
           "\"\< \>\"", ",", "InfoFromAudi2017"}], "]"}], ";"}], "*)"}], 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Abs", "[", 
           RowBox[{
            RowBox[{"FrontFactor", "/", 
             RowBox[{"InfoFromAudi2017", "[", 
              RowBox[{"[", "2", "]"}], "]"}]}], "-", "1"}], "]"}], ">", 
          "0.001"}], ",", 
         RowBox[{"Print", "[", 
          RowBox[{
          "Name", ",", "\"\< WARNING. We use \[Alpha]=\>\"", ",", 
           "FrontFactor", ",", "\"\< but we should use \>\"", ",", 
           RowBox[{"InfoFromAudi2017", "[", 
            RowBox[{"[", "2", "]"}], "]"}]}], "]"}]}], "\[IndentingNewLine]", 
        "]"}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Abs", "[", 
           RowBox[{
            RowBox[{"Qoverkb", "/", 
             RowBox[{"InfoFromAudi2017", "[", 
              RowBox[{"[", "4", "]"}], "]"}]}], "-", "1"}], "]"}], ">", 
          "0.001"}], ",", "\[IndentingNewLine]", 
         RowBox[{"Print", "[", 
          RowBox[{
          "Name", ",", " ", 
           "\"\< WARNING. We use Q/\!\(\*SubscriptBox[\(k\), \(B\)]\)=\>\"", 
           ",", "Qoverkb", ",", "\"\< but we should use \>\"", ",", 
           RowBox[{"InfoFromAudi2017", "[", 
            RowBox[{"[", "4", "]"}], "]"}]}], "]"}]}], "\[IndentingNewLine]", 
        "]"}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"PoweronT9", "=!=", 
