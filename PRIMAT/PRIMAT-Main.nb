      RowBox[{
       RowBox[{
        RowBox[{"(", "FormalReactions18", ")"}], "/.", 
        RowBox[{"Dispatch", "@", 
         RowBox[{"Rules\[Lambda]", "[", "Temp", "]"}]}]}], "/.", 
       RowBox[{"Dispatch", "@", 
        RowBox[{"Rules\[Lambda]bar", "[", "Temp", "]"}]}]}], "/.", 
      RowBox[{"Dispatch", "@", 
       RowBox[{"RulesY", "[", "time", "]"}]}]}], "/.", 
     RowBox[{"A\[Rho]B", "\[Rule]", "\[Rho]B"}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"DY", "[", 
