Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Fermi", "[", 
    RowBox[{"sgnq_", ",", "signE_", ",", 
     RowBox[{"b_", "?", "NumericQ"}]}], "]"}], ":=", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"sgnq", " ", "signE"}], " ", ">", "0"}], ",", 
