Cell[TextData[{
 "We consider\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"1", "+", 
         SubscriptBox[
          StyleBox["w", "TI"], "EDE"], 
         RowBox[{"(", 
           StyleBox["a", "TI"], ")"}], "\[LongEqual]", 
         FractionBox[
          RowBox[{"1", "+", 
            SubscriptBox[
             StyleBox["w", "TI"], 
             StyleBox["n", "TI"]]}], 
          RowBox[{"1", "+", 
            SuperscriptBox[
             RowBox[{"(", 
               RowBox[{
                 SubscriptBox[
                  StyleBox["a", "TI"], 
                  StyleBox["c", "TI"]], "/", 
                 StyleBox["a", "TI"]}], ")"}], 
             RowBox[{"3", "(", 
               RowBox[{"1", "+", 
                 SubscriptBox[
                  StyleBox["w", "TI"], 
                  StyleBox["n", "TI"]]}], ")"}]]}]]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "1+w_{\\rm EDE}(a) = \\frac{1+w_n}{1+(a_c/a)^{3(1+w_n)}}", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "67ff596c-a95c-4d8f-b296-c9a2da67f4b8"],
 "\nwhich implies with \n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          OverscriptBox["\[Rho]", "."], "EDE"], "\[LongEqual]", "-3", 
         StyleBox["H", "TI"], 
         SubscriptBox["\[Rho]", "EDE"], 
         RowBox[{"(", 
           RowBox[{"1", "+", 
             SubscriptBox[
              StyleBox["w", "TI"], "EDE"]}], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\dot{\\rho}_{\\text{EDE}} = -3H \\rho_{\\text{EDE}} \
(1+w_{\\text{EDE}})", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d36dbe90-604b-40f4-a3e8-c94e19d00e34"],
 "\nthat\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[Rho]", "EDE"], "\[LongEqual]", 
         SubsuperscriptBox["\[Rho]", "EDE", "0"], 
         FractionBox[
          RowBox[{"1", "+", 
            SuperscriptBox[
             RowBox[{"(", 
               RowBox[{
                 SubscriptBox[
                  StyleBox["a", "TI"], "0"], "/", 
                 SubscriptBox[
                  StyleBox["a", "TI"], 
                  StyleBox["c", "TI"]]}], ")"}], 
             RowBox[{"3", "(", 
               RowBox[{"1", "+", 
                 SubscriptBox[
                  StyleBox["w", "TI"], 
                  StyleBox["n", "TI"]]}], ")"}]]}], 
          RowBox[{"1", "+", 
            SuperscriptBox[
             RowBox[{"(", 
               RowBox[{
                 StyleBox["a", "TI"], "/", 
                 SubscriptBox[
                  StyleBox["a", "TI"], 
                  StyleBox["c", "TI"]]}], ")"}], 
             RowBox[{"3", "(", 
               RowBox[{"1", "+", 
                 SubscriptBox[
                  StyleBox["w", "TI"], 
                  StyleBox["n", "TI"]]}], ")"}]]}]], "\[LongEqual]", "2", 
         SubscriptBox["\[Rho]", "EDE"], 
         RowBox[{"(", 
           SubscriptBox[
            StyleBox["a", "TI"], 
            StyleBox["c", "TI"]], ")"}], 
         FractionBox["1", 
          RowBox[{"1", "+", 
            SuperscriptBox[
             RowBox[{"(", 
               RowBox[{
                 StyleBox["a", "TI"], "/", 
                 SubscriptBox[
                  StyleBox["a", "TI"], 
                  StyleBox["c", "TI"]]}], ")"}], 
             RowBox[{"3", "(", 
               RowBox[{"1", "+", 
                 SubscriptBox[
                  StyleBox["w", "TI"], 
                  StyleBox["n", "TI"]]}], ")"}]]}]]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\rho_{\\text{EDE}} = \\rho_{\\text{EDE}}^0 \
\\frac{1+(a_0/a_c)^{3(1+w_n)}}{1+(a/a_c)^{3(1+w_n)}} = 2 \
\\rho_{\\text{EDE}}(a_c) \\frac{1}{1+(a/a_c)^{3(1+w_n)}}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "96ea575f-e63d-4b19-8378-6863745bda45"],
 "\nAssuming that radiation scales only as ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "/", 
    SuperscriptBox["a", "4"]}], TraditionalForm]],ExpressionUUID->
  "57bb97a1-247a-449b-ae6a-0f1b7f4585d2"],
 " the maximum of ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[Rho]", "EDE"], "/", 
         RowBox[{"(", 
           RowBox[{
             SubscriptBox["\[Rho]", "EDE"], "+", 
             SubscriptBox["\[Rho]", "rad"]}], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\rho_{\\text{EDE}}/(\\rho_{\\text{EDE}} + \\rho_{\\text{rad}})", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e806c05b-730f-4093-8c60-1d8f162ea9fe"],
 " is obtained when\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["a", "TI"], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["a", "TI"], 
          StyleBox["c", "TI"]], 
         SuperscriptBox[
          RowBox[{"(", 
            FractionBox["4", 
             RowBox[{"3", 
               SubscriptBox[
                StyleBox["w", "TI"], 
                StyleBox["n", "TI"]], "-", "1"}]], ")"}], 
          RowBox[{"1", "/", 
            RowBox[{"(", 
              RowBox[{"3", "(", 
                RowBox[{"1", "+", 
                  SubscriptBox[
                   StyleBox["w", "TI"], 
                   StyleBox["n", "TI"]]}], ")"}], ")"}]}]]}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "a = a_c \\left(\\frac{4}{3w_n-1}\\right)^{1/(3(1+w_n))}", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "106c9bf9-e1ef-47cd-87a7-e63650ab2a91"],
 "\nWe parametrize with the value of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["a", "c"], TraditionalForm]],ExpressionUUID->
  "37ffa94e-5fe9-48d8-8abf-e5b951bfffe9"],
 " or ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["z", "c"], TraditionalForm]],ExpressionUUID->
  "b1e57996-c6ae-4b5f-ae9a-2fc0a36d2ca4"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Rho]", "(", 
    SubscriptBox["a", "c"]}], TraditionalForm]],ExpressionUUID->
  "7e4cf325-8412-4e77-afa4-88b8323101df"],
 "). \n\nOr even better we can parameterize with the maximum fraction of EDE. \
Assuming that radiation scales only as ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "/", 
    SuperscriptBox["a", "4"]}], TraditionalForm]],ExpressionUUID->
  "5a1bdfe9-e6aa-41d4-98a7-1a83a80e5032"],
 ", hence after reheating, we get\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[Rho]", "EDE"], 
         RowBox[{"(", 
           SubscriptBox[
            StyleBox["a", "TI"], 
            StyleBox["c", "TI"]], ")"}], "\[LongEqual]", 
         FractionBox[
          SubscriptBox[
           StyleBox["f", "TI"], "EDE"], 
          RowBox[{"1", "-", 
            SubscriptBox[
             StyleBox["f", "TI"], "EDE"]}]], 
         FractionBox[
          RowBox[{
            SubscriptBox["\[Rho]", 
             StyleBox["c", "TI"]], 
            SubsuperscriptBox["\[CapitalOmega]", 
             StyleBox["r", "TI"], "0"]}], "2"], 
         FractionBox[
          SubsuperscriptBox[
           StyleBox["a", "TI"], "0", "4"], 
          SubsuperscriptBox[
           StyleBox["a", "TI"], "max", "4"]], 
         RowBox[{"(", 
           RowBox[{"1", "+", 
             FractionBox["4", 
              RowBox[{"3", 
                SubscriptBox[
                 StyleBox["w", "TI"], 
                 StyleBox["n", "TI"]], "-", "1"}]]}], ")"}]}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "\\rho_{\\text{EDE}}(a_c) = \\frac{f_{\\text{EDE}}}{1-f_{\\text{EDE}}} \
\\frac{\\rho_c \\Omega_r^0}{2}\\frac{a_0^4}{a_{\\text{max}}^4}(1+\\frac{4}{3 \
w_n -1})", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "23f3dd18-11d3-4ddf-b808-87a615e574ac"],
 "\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["a", "TI"], "max"], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["a", "TI"], 
          StyleBox["c", "TI"]], 
         SuperscriptBox[
          RowBox[{"(", 
            FractionBox["4", 
             RowBox[{"3", 
               SubscriptBox[
                StyleBox["w", "TI"], 
                StyleBox["n", "TI"]], "-", "1"}]], ")"}], 
          RowBox[{"1", "/", 
            RowBox[{"(", 
              RowBox[{"3", 
                SubscriptBox[
                 StyleBox["w", "TI"], 
                 StyleBox["n", "TI"]], "+", "3"}], ")"}]}]]}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "a_{\\text{max}} = a_c (\\frac{4}{3w_n -1})^{1/(3w_n+3)}", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "9c3c9168-a2fd-4e74-9ec9-f200c2ad4f6c"]
}], "Text",
 CellChangeTimes->{{3.988434743326124*^9, 3.9884347672240267`*^9}, {
  3.988434810374872*^9, 3.988434824143628*^9}, {3.988434944902372*^9, 
