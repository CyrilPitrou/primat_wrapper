Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"dg\[Rho]N", "[", 
    RowBox[{"T_", "?", "NumericQ"}], "]"}], ":=", 
   RowBox[{"Which", "[", 
    RowBox[{
     RowBox[{"T", "<", "Tf"}], ",", "0", ",", 
     RowBox[{"T", "\[LessEqual]", "Ti"}], " ", ",", 
