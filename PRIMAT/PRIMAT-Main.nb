Cell[TextData[{
 "Table in mass fraction instead of number fraction. So we use ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["X", "i"], " ", "=", " ", 
    RowBox[{
     SubscriptBox["A", "i"], " ", 
     RowBox[{
      SubscriptBox["Y", "i"], "."}]}]}], TraditionalForm]],ExpressionUUID->
  "3d8b8b33-7db5-4863-9570-5475e06ac205"]
}], "Text",ExpressionUUID->"f427efda-3c35-423d-8a2d-5e67de5bf8be"],

