Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"TreatData", "[", "Data_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "reac", ",", "constants", ",", "ireaction", ",", "MaxNumberReaction", 
       ",", "ReferencePaper", ",", "dat", ",", "rest", ",", "list", ",", 
       "resultat", ",", "reacreshaped", ",", "replacements", ",", "time"}], 
      "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"resultat", "=", 
       RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"list", "=", "Data"}], ";", "\[IndentingNewLine]", 
      RowBox[{"ireaction", "=", "1"}], ";", "\[IndentingNewLine]", 
      RowBox[{"MaxNumberReaction", ":=", 
       RowBox[{"If", "[", 
        RowBox[{
        "$ReducedNetwork", ",", "SmallNuclearNetworkSize", ",", "Infinity"}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"While", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"Length", "@", "list"}], ">", "0"}], ")"}], "&&", 
         RowBox[{"ireaction", "<=", "MaxNumberReaction"}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"reac", "=", 
          RowBox[{"list", "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"ReferencePaper", "=", 
          RowBox[{"StringDrop", "[", 
           RowBox[{
            RowBox[{"list", "[", 
             RowBox[{"[", 
              RowBox[{"2", ",", "1"}], "]"}], "]"}], ",", "2"}], "]"}]}], ";",
          "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{
           RowBox[{"Print", "[", "ReferencePaper", "]"}], ";"}], "*)"}], 
         "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{
           RowBox[{"Print", "[", "reac", "]"}], ";"}], "*)"}], 
         "\[IndentingNewLine]", 
         RowBox[{"constants", "=", 
          RowBox[{"list", "[", 
           RowBox[{"[", "3", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"rest", "=", 
          RowBox[{"Drop", "[", 
           RowBox[{"list", ",", "3"}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"dat", "=", 
          RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"While", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"rest", "=!=", 
             RowBox[{"{", "}"}]}], "&&", 
            RowBox[{"NumericQ", "[", 
             RowBox[{"rest", "[", 
              RowBox[{"[", 
               RowBox[{"1", ",", "1"}], "]"}], "]"}], "]"}]}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"dat", "=", 
             RowBox[{"Append", "[", 
              RowBox[{"dat", ",", 
               RowBox[{"rest", "[", 
                RowBox[{"[", "1", "]"}], "]"}]}], "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"rest", "=", 
             RowBox[{"Rest", "@", "rest"}]}], ";"}]}], "\[IndentingNewLine]", 
          "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{"list", "=", "rest"}], ";", "\[IndentingNewLine]", 
         RowBox[{"reacreshaped", "=", 
          RowBox[{"Append", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"ReplaceMultipleElementList", "@", 
               RowBox[{"Select", "[", 
                RowBox[{"reac", ",", 
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{"#", "=!=", "\"\<+\>\""}], "&&", 
                    RowBox[{"#", "=!=", "\"\<*-\>\""}]}], ")"}], "&"}]}], 
                "]"}]}], ",", "constants", ",", "ReferencePaper"}], "}"}], 
            ",", "dat"}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"resultat", "=", 
          RowBox[{"Append", "[", 
           RowBox[{"resultat", ",", 
            RowBox[{"reacreshaped", "/.", "ListSimplificationNotation"}]}], 
           "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"ireaction", "++"}], ";"}]}], "\[IndentingNewLine]", "]"}], 
      ";", "\[IndentingNewLine]", "resultat"}]}], "\[IndentingNewLine]", 
    "]"}]}], ";"}]], "Input",
