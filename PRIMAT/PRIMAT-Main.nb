Cell["\<\
Baryons density is obtained from its valued today scaled by dilution (no \
thermal effects, so it is only the energy density due to rest mass of \
baryons).\
\>", "Text",
 InitializationCell->True,
 CellChangeTimes->{{3.698381548831592*^9, 3.698381587689069*^9}, {
  3.698381712674609*^9, 3.698381713847342*^9}, {3.72268429270203*^9, 
  3.7226842927788467`*^9}},ExpressionUUID->"de1b50c7-8d47-4232-a1e0-\
4c5a6aee99ea"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"\[Rho]B", "[", "av_", "]"}], ":=", 
   FractionBox[
    RowBox[{"\[Rho]B0", " "}], 
    SuperscriptBox["av", "3"]]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"nB", "[", "av_", "]"}], ":=", 
   FractionBox[
    RowBox[{"nbaryons0", " "}], 
    SuperscriptBox["av", "3"]]}], ";"}]}], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.6940760647311373`*^9, 3.694076086584598*^9}, 
   3.6940775812992077`*^9, {3.6950153891602573`*^9, 3.695015401945507*^9}, 
   3.699777730164369*^9, {3.703301763791449*^9, 3.7033017812452106`*^9}, {
   3.703301856829289*^9, 3.703301884160434*^9}, {3.7033019622788973`*^9, 
   3.703302010284329*^9}, {3.703309078528803*^9, 3.703309084459551*^9}, {
   3.70330915000527*^9, 3.7033091551230507`*^9}, {3.7033094268067408`*^9, 
   3.70330943101259*^9}, {3.703310624023806*^9, 3.7033106326646957`*^9}, {
   3.703572255417985*^9, 3.703572262727487*^9}, {3.713914269515983*^9, 
   3.713914315642177*^9}, {3.7159380312627573`*^9, 3.715938033149338*^9}, 
   3.7159381136083307`*^9, {3.715943152076902*^9, 3.715943152585827*^9}, {
   3.7177391883342752`*^9, 3.717739198110692*^9}, {3.722608880646167*^9, 
   3.7226088973996553`*^9}},
 CellLabel->
  "In[193]:=",ExpressionUUID->"d67845b2-bd5b-4404-bf27-9a9b3efac911"],

Cell["\<\
For nuclear reactions, the mass density of baryons is in fact a number \
density of species multiplied by the atomic mass (see appendix C1 of \
companion paper for a detailed discussion). 
This differs slightly from the mass density of baryons and we take this into \
account.\
\>", "Text",ExpressionUUID->"af8417ac-769b-4b4e-a2f1-ee9cd5212662"],

Cell["\<\
If $CorrectBaryonsEnergyDensityinBBNRRates is set to False, then we use the \
baryons density naively in nuclear rates. 
Otherwise we take into account that the baryons density is in fact the number \
density times the atomic mass as explained in App. C1 of the companion Phys. \
Rept. paper.\
\>", "Text",
 CellChangeTimes->{{3.937274807566828*^9, 
  3.937274809562216*^9}},ExpressionUUID->"d2fc8ee1-bd12-4824-99bf-\
69f9e3cfa8eb"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"$CorrectBaryonsEnergyDensityinBBNRRates", "=", "True"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"\[Rho]BForBBN", "[", "av_", "]"}], ":=", 
    RowBox[{
     RowBox[{"\[Rho]B", "[", "av", "]"}], 
     RowBox[{"If", "[", 
      RowBox[{"$CorrectBaryonsEnergyDensityinBBNRRates", ",", 
       RowBox[{"ma", "/", "mbaryon0"}], ",", "1"}], "]"}]}]}], ";"}], 
  RowBox[{"(*", " ", 
   RowBox[{"This", " ", "is", " ", 
    RowBox[{"Eq", ".", " ", "C8"}], " ", "of", " ", "the", " ", "companion", 
    " ", "paper"}], " ", "*)"}]}]}], "Input",
 InitializationCell->True,
 CellLabel->
  "In[195]:=",ExpressionUUID->"7538b65a-b46f-429f-b38d-a17071401dcf"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Distribution functions", "Subsection",
 InitializationCell->True,
 CellChangeTimes->{{3.695399796918549*^9, 3.695399804547086*^9}, {
