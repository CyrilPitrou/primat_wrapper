 CellChangeTimes->{{3.936355293664341*^9, 3.936355298282258*^9}, {
  3.936414593543816*^9, 3.936414610111018*^9}},
 CellLabel->
  "In[177]:=",ExpressionUUID->"c1877868-556a-4764-9751-c25d81e40b80"],

Cell["\<\
This is the (average) mass of baryons today (that is of nucleons), taking \
into account that part is in Hydrogen and part in Helium. We use the current \
chemical composition with 24.75 % of Helium but this is subject to \
controversy. Indeed the abundance of baryons is measured with CMB, and thus \
refers to an epoch (z ~1100) where the composition was the same as the one at \
the end of BBN. See Eqs. C5 C6 in companion paper.\
\>", "Text",ExpressionUUID->"87809633-6125-462f-ad75-b2933530e0aa"],

