Cell["\<\
The results of RunPRIMAT are gathered in the files MC (abundances) RV (rates \
variations) Cosmo (List of cosmological parameters, limited to baryons \
abundances and neutron lifetime)\
\>", "Text",
 CellChangeTimes->{{3.7226878213161993`*^9, 3.722687886209819*^9}, 
   3.722698611505405*^9, 3.725263178319779*^9, 
   3.809771817279756*^9},ExpressionUUID->"095e8f97-a5d0-450c-8083-\
a8c93d9eb231"],

Cell["\<\
We define functions to dump the results of a Monte-Carlo in a file and also \
the converse to load the result so as to analyze and use it.\
\>", "Text",ExpressionUUID->"e9612649-c510-4bb9-ab0c-c1360d079832"],

Cell[BoxData[
 RowBox[{"Clear", "[", 
  RowBox[{"LoadMC", ",", "DumpMC"}], "]"}]], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.720344641965357*^9, 3.720344645338798*^9}},
 CellLabel->
  "In[902]:=",ExpressionUUID->"6481ea29-13d3-4f51-8507-846d43f68016"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"DumpMC", "[", "File_String", "]"}], ":=", 
    RowBox[{"(", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Print", "[", 
       RowBox[{"\"\<Exporting \>\"", ",", 
        RowBox[{"\"\<Results/MC\>\"", "<>", "File", "<>", "\"\<.dat\>\""}]}], 
       "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"Export", "[", 
       RowBox[{
        RowBox[{
        "$ResultsDirectory", "<>", "\"\<MC\>\"", "<>", "File", "<>", 
         "\"\<.dat\>\""}], ",", "MC"}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<Exporting \>\"", ",", 
        RowBox[{"\"\<Results/MC\>\"", "<>", "File", "<>", "\"\<.mx\>\""}]}], 
       "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"DumpSave", "[", 
       RowBox[{
        RowBox[{
        "$ResultsDirectory", "<>", "\"\<MC\>\"", "<>", "File", "<>", 
         "\"\<.mx\>\""}], ",", "MC"}], "]"}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<Exporting \>\"", ",", 
        RowBox[{"\"\<Results/RV\>\"", "<>", "File", "<>", "\"\<.dat\>\""}]}], 
       "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"Export", "[", 
       RowBox[{
        RowBox[{
        "$ResultsDirectory", "<>", "\"\<RV\>\"", "<>", "File", "<>", 
         "\"\<.dat\>\""}], ",", "RV"}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<Exporting \>\"", ",", 
        RowBox[{"\"\<Results/RV\>\"", "<>", "File", "<>", "\"\<.mx\>\""}]}], 
       "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"DumpSave", "[", 
       RowBox[{
        RowBox[{
        "$ResultsDirectory", "<>", "\"\<RV\>\"", "<>", "File", "<>", 
         "\"\<.mx\>\""}], ",", "RV"}], "]"}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<Exporting \>\"", ",", 
        RowBox[{
        "\"\<Results/Cosmo\>\"", "<>", "File", "<>", "\"\<.dat\>\""}]}], 
       "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"Export", "[", 
       RowBox[{
        RowBox[{
        "$ResultsDirectory", "<>", "\"\<Cosmo\>\"", "<>", "File", "<>", 
         "\"\<.dat\>\""}], ",", "Cosmo"}], "]"}], ";"}], 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"DumpSave", "[", 
        RowBox[{
         RowBox[{"\"\<Results/Cosmo\>\"", "<>", "File", "<>", "\"\<.mx\>\""}],
          ",", "Cosmo"}], "]"}], ";"}], "*)"}], "\[IndentingNewLine]", 
     ")"}]}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"LoadMC", "[", "File_String", "]"}], ":=", 
   RowBox[{"(", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Get", "[", 
      RowBox[{
      "$ResultsDirectory", "<>", "\"\<MC\>\"", "<>", "File", "<>", 
       "\"\<.mx\>\""}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"MCfile", "=", 
        RowBox[{"\"\<Results/MC\>\"", "<>", "File", "<>", "\"\<.dat\>\""}]}], 
       ";", "\[IndentingNewLine]", " ", 
       RowBox[{"MC", "=", 
        RowBox[{"Import", "[", "MCfile", "]"}]}], ";"}], "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"Get", "[", 
      RowBox[{
      "$ResultsDirectory", "<>", "\"\<RV\>\"", "<>", "File", "<>", 
       "\"\<.mx\>\""}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"RVfile", "=", 
        RowBox[{"\"\<Results/RV\>\"", "<>", "File", "<>", "\"\<.dat\>\""}]}], 
       ";", "\[IndentingNewLine]", 
       RowBox[{"RV", "=", 
        RowBox[{"Import", "[", "RVfile", "]"}]}], ";"}], "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"Cosmofile", "=", 
      RowBox[{
      "$ResultsDirectory", "<>", "\"\<Cosmo\>\"", "<>", "File", "<>", 
       "\"\<.dat\>\""}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Cosmo", "=", 
      RowBox[{"Import", "[", "Cosmofile", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"TMC", "=", 
      RowBox[{"Transpose", "[", "MC", "]"}]}], ";"}], "\[IndentingNewLine]", 
    ")"}]}], ";"}]}], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.9368952498626423`*^9, 3.93689525699711*^9}, {
  3.9370819264339523`*^9, 3.93708205828223*^9}, {3.937082662878845*^9, 
  3.937082673681471*^9}, {3.937184868655818*^9, 3.937184914377339*^9}},
 CellLabel->
  "In[903]:=",ExpressionUUID->"54aa6a47-2a91-4054-9b02-2481898b0a64"],

Cell["\<\
Whenever a Monte-Carlo is finished, or loaded, we can obtain the table of \
values for a given element, or a given reaction\
\>", "Text",
 CellChangeTimes->{{3.7226879167402687`*^9, 
  3.722687950095561*^9}},ExpressionUUID->"a961fbfb-55df-42ea-a9ff-\
c50c682f6dfc"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ElementColumn", "[", "el_", "]"}], ":=", 
   RowBox[{"MC", "[", 
    RowBox[{"[", 
     RowBox[{"All", ",", 
      RowBox[{"KeyVal", "[", 
       RowBox[{"[", "el", "]"}], "]"}]}], "]"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"ReactionColumn", "[", "el_", "]"}], ":=", 
   RowBox[{"RV", "[", 
    RowBox[{"[", 
     RowBox[{"All", ",", 
      RowBox[{"KeyNuclearReaction", "[", "el", "]"}]}], "]"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"h2\[CapitalOmega]b0List", ":=", 
   RowBox[{"Cosmo", "[", 
    RowBox[{"[", 
     RowBox[{"All", ",", "1"}], "]"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Tau]neutronList", ":=", 
   RowBox[{"Cosmo", "[", 
    RowBox[{"[", 
     RowBox[{"All", ",", "2"}], "]"}], "]"}]}], ";"}]}], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.699888472755859*^9, 3.699888568573728*^9}, {
   3.6998885997439537`*^9, 3.699888607248598*^9}, 3.699892178853861*^9, {
   3.7002210338590803`*^9, 3.700221037439067*^9}, 3.715956578169876*^9, 
   3.719923896887396*^9, {3.7199250253513527`*^9, 3.719925026936667*^9}},
 CellLabel->
  "In[905]:=",ExpressionUUID->"09447937-81af-418e-a30d-f1940e3e1dd7"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "I", " ", "think", " ", "this", " ", "function", " ", "is", " ", "never", 
    " ", 
    RowBox[{"used", " ", "!"}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"ReSetCosmology", ":=", 
    RowBox[{"(", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
      "Meanh2\[CapitalOmega]b0", "=", "Meanh2\[CapitalOmega]b0Planck"}], ";", 
      " ", "\[IndentingNewLine]", 
      RowBox[{"NeutrinosGenerations", "=", "3"}], ";", "\[IndentingNewLine]", 
      
      RowBox[{"Nrelat", "=", "0"}], ";"}], 
     RowBox[{"(*", " ", 
      RowBox[{"Not", " ", "sure", " ", "this", " ", "is", " ", 
       RowBox[{"needed", "."}]}], " ", "*)"}], "\[IndentingNewLine]", ")"}]}],
    ";"}]}]], "Input",
 InitializationCell->True,
