Cell["\<\
We also determine if we need to load all NEVO results (with the grids on y = \
p/Tcm as a function of temperature), or if we need only the first columns \
with temperature .\
\>", "Text",
 CellChangeTimes->{{3.937273576562242*^9, 
  3.937273618711563*^9}},ExpressionUUID->"36dca12c-e26b-4307-af22-\
ab8963d9c225"],

Cell[BoxData[
 RowBox[{
  RowBox[{"$NeedNEVODistortions", ":=", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{"$NEVO", "&&", "$SpectralDistortions", "&&", 
      RowBox[{"Not", "[", "$AnalyticDistortions", "]"}]}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{"$RecomputeWeakRates", ",", "True", ",", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Not", "[", 
           RowBox[{"FileExistsQ", "[", "NamePENFilenp", "]"}], "]"}], "||", 
          RowBox[{"Not", "[", 
           RowBox[{"FileExistsQ", "[", "NamePENFilepn", "]"}], "]"}]}], ",", 
         "True", ",", "False"}], "]"}]}], "]"}], ",", "False"}], "]"}]}], 
  ";"}]], "Input",
 InitializationCell->True,
