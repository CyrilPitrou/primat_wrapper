         RowBox[{"StringJoin", "@@", 
          RowBox[{"ToString", "/@", "InitialParticles"}]}], "<>", 
         "\"\<TO\>\"", "<>", 
         RowBox[{"StringJoin", "@@", 
          RowBox[{"ToString", "/@", "FinalParticles"}]}]}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"Q", "=", 
        RowBox[{"constants", "[", 
         RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"FrontFactor", "=", 
        RowBox[{"constants", "[", 
         RowBox[{"[", "2", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
