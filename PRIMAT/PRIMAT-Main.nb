Cell[BoxData[{
 RowBox[{
  RowBox[{"FourOverElevenQED", ":=", 
   RowBox[{"1", "/", 
    RowBox[{"(", 
     RowBox[{
      FractionBox["11", "4"], "-", 
      FractionBox[
       RowBox[{"25", " ", "\[Alpha]FS"}], 
       RowBox[{"8", "\[Pi]"}]], "+", 
      RowBox[{"If", "[", 
       RowBox[{"$QEDOe3", ",", 
        RowBox[{
         FractionBox[
          RowBox[{"10", " ", 
           SuperscriptBox["\[Alpha]FS", 
            RowBox[{"(", 
             RowBox[{"3", "/", "2"}], ")"}]]}], 
          SuperscriptBox["\[Pi]", "2"]], 
         RowBox[{"Sqrt", "[", 
          FractionBox["\[Pi]", "3"], "]"}]}], ",", "0"}], "]"}]}], ")"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"FourOverElevenNoQED", ":=", 
   FractionBox["4", "11"]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"FourOverEleven", ":=", 
    RowBox[{"If", "[", 
     RowBox[{
     "$QEDPlasmaCorrections", ",", "FourOverElevenQED", ",", 
      "FourOverElevenNoQED"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
