 FontFamily->"Arial",ExpressionUUID->"5b898a01-70b0-47e1-b3b1-7312505527a6"],

Cell[BoxData[
 RowBox[{
  RowBox[{"CheckOptions", ":=", 
   RowBox[{"(", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Not", "@", "$QEDPlasmaCorrections"}], " ", "&&", " ", 
        "$CompleteQEDPressure"}], ",", " ", 
       RowBox[{
        RowBox[{
        "Print", "[", 
         "\"\<Inconsistent Options, I set $CompleteQEDPressure=False\>\"", 
         "]"}], ";", 
        RowBox[{"$CompleteQEDPressure", "=", "False"}], ";"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Not", "@", "$QEDPlasmaCorrections"}], " ", "&&", " ", 
        "$QEDOe3"}], ",", 
       RowBox[{
        RowBox[{
        "Print", "[", "\"\<Inconsistent Options, I set $QEDOe3=False\>\"", 
         "]"}], ";", 
        RowBox[{"$QEDOe3", "=", "False"}], ";"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Not", "@", "$NEVO"}], "&&", "$TrueT\[Nu]e"}], ",", 
       RowBox[{
        RowBox[{
        "Print", "[", 
         "\"\<Inconsistent Options, I set $TrueT\[Nu]e=False\>\"", "]"}], ";", 
        RowBox[{"$TrueT\[Nu]e", "=", "False"}], ";"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Not", "@", "$NEVO"}], "&&", 
        RowBox[{"Not", "[", "$AnalyticDistortions", "]"}], "&&", 
        "$SpectralDistortions"}], ",", 
       RowBox[{
        RowBox[{
        "Print", "[", 
         "\"\<Inconsistent Options, I set $SpectralDistortions=False\>\"", 
         "]"}], ";", 
        RowBox[{"$SpectralDistortions", "=", "False"}], ";"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"$NEVO", "&&", 
        RowBox[{"Not", "[", "$IncompleteNeutrinoDecoupling", "]"}]}], ",", 
       RowBox[{
        RowBox[{
        "Print", "[", "\"\<Inconsistent Options, I set $NEVO=False\>\"", 
         "]"}], ";", 
        RowBox[{"$NEVO", "=", "False"}], ";"}]}], "]"}]}], 
    "\[IndentingNewLine]", ")"}]}], ";"}]], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.936399258435788*^9, 3.936399278513935*^9}, {
  3.936399353747715*^9, 3.936399406695961*^9}, {3.9364042258732147`*^9, 
  3.936404247049448*^9}, {3.936409045215209*^9, 3.9364090459365177`*^9}, {
