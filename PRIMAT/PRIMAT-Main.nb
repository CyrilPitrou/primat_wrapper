     RowBox[{"(", "GF", ")"}], "2"], 
    RowBox[{"(", 
     RowBox[{"1", "+", 
      RowBox[{"3", 
       SuperscriptBox[
        RowBox[{"(", "gA", ")"}], "2"]}]}], ")"}], 
    RowBox[{
     SuperscriptBox["me", "5"], "/", 
     RowBox[{"(", 
      RowBox[{"2", 
