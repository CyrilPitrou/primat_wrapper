Cell["\<\
We prefer using the most recent nubase (2020) (see comments about mass \
database at the top of this notebook) from the file nubase_4.mas20.txt  \
(Chinese Physics C 45 (2021) 030001).\
\>", "Text",
 CellChangeTimes->{{3.9355481542802467`*^9, 3.935548184579225*^9}, {
  3.9355487084541807`*^9, 
  3.935548728031207*^9}},ExpressionUUID->"52938a65-a1bb-436d-a2db-\
dccede444591"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"StringListParticles", "=", 
   RowBox[{"Drop", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"#", "[", 
        RowBox[{"[", "1", "]"}], "]"}], "&"}], "/@", 
      RowBox[{"Import", "[", 
       RowBox[{"\"\<nubase_4.mas20.txt\>\"", ",", "\"\<TSV\>\""}], "]"}]}], 
     ",", "25"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"NubTabChar", "=", 
   RowBox[{"Select", "[", 
    RowBox[{
     RowBox[{"Characters", "/@", "StringListParticles"}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{"Length", "[", "#", "]"}], "\[GreaterEqual]", "93"}], "&"}]}], 
    "]"}]}], ";"}]}], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.8965445567111263`*^9, 3.89654455825777*^9}, {
   3.935548009451344*^9, 3.935548014312079*^9}, {3.935548189714218*^9, 
   3.9355481921422043`*^9}, 3.935548331058107*^9, 3.935550144019464*^9},
 CellLabel->
  "In[668]:=",ExpressionUUID->"b00dc018-54ea-4ab0-8ee8-058d567d86fe"],

Cell["\<\
NUBASE 2020 Syntax :
The first three characters of each line are the A. 
Characters from 5 to 7 are Z (but the 8th character is a number for a \
possible excited state. Hence we use character 5 to 8 for 10*Z, and then \
divide by 10. If it is an integer it is not an excited state. Otherwise it is \
discarded. This is a dirty hack)
From 19 to 31 it is mass excess.
From 89 to 102 it is some information on spin and parity.\
\>", "Text",
 CellChangeTimes->{{3.717579969237245*^9, 3.717580016288292*^9}, {
  3.717581039288995*^9, 3.717581040951882*^9}, {3.722697499636197*^9, 
  3.722697502999465*^9}, {3.935548292986759*^9, 3.9355483002600327`*^9}, {
  3.935548535367462*^9, 3.935548537845581*^9}, {3.9355485841728773`*^9, 
  3.935548618136272*^9}, {3.9355487664405727`*^9, 3.935548769008533*^9}, {
  3.935550145683875*^9, 3.93555015487645*^9}, {3.9360660544346867`*^9, 
  3.936066055082634*^9}},ExpressionUUID->"700218d2-3d41-4501-884d-\
5047a9778fbb"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Alist", "=", 
   RowBox[{"ToExpression", "/@", 
    RowBox[{"StringJoin", "/@", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"Take", "[", 
         RowBox[{"#", ",", 
          RowBox[{"{", 
           RowBox[{"1", ",", "3"}], "}"}]}], "]"}], "&"}], "/@", 
       "NubTabChar"}], ")"}]}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Zlist", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"#", "/", "10"}], "&"}], "/@", 
    RowBox[{"ToExpression", "/@", 
     RowBox[{"StringJoin", "/@", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"Take", "[", 
          RowBox[{"#", ",", 
           RowBox[{"{", 
            RowBox[{"5", ",", "8"}], "}"}]}], "]"}], "&"}], "/@", 
        "NubTabChar"}], ")"}]}]}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"MassExcessesString", "=", 
   RowBox[{"MassFromCharList", "/@", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"Take", "[", 
        RowBox[{"#", ",", 
         RowBox[{"{", 
          RowBox[{"19", ",", "31"}], "}"}]}], "]"}], "&"}], "/@", 
      "NubTabChar"}], ")"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Spins", "=", 
   RowBox[{"SpinFromCharList", "/@", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"Take", "[", 
        RowBox[{"#", ",", 
         RowBox[{"{", 
          RowBox[{"89", ",", "93"}], "}"}]}], "]"}], "&"}], "/@", 
      "NubTabChar"}], ")"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Nlist", "=", 
   RowBox[{"Alist", "-", "Zlist"}]}], ";"}]}], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.7175599940621233`*^9, 3.717560001275188*^9}, {
   3.717571816855294*^9, 3.717571818701933*^9}, {3.717573447035048*^9, 
