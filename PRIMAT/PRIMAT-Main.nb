Cell[BoxData[
 RowBox[{
  RowBox[{"MyGrid", "[", "Table_List", "]"}], ":=", 
  RowBox[{"Grid", "[", 
   RowBox[{"Table", ",", 
    RowBox[{"Frame", "\[Rule]", "All"}]}], "]"}]}]], "Input",
 InitializationCell->True,
