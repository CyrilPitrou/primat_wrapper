4684a958c6a9"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"\[Rho]FD", "[", "c_", "]"}], "=", 
    RowBox[{
     FractionBox["1", 
      RowBox[{"2", 
       SuperscriptBox["\[Pi]", "2"]}]], 
     RowBox[{
      SubsuperscriptBox["\[Integral]", "0", "Infinity"], 
      RowBox[{
       FractionBox[
        SuperscriptBox["y", "3"], 
        RowBox[{"(", 
         RowBox[{
          SuperscriptBox["\[ExponentialE]", 
           RowBox[{"y", "-", "c"}]], "+", "1"}], ")"}]], 
       RowBox[{"\[DifferentialD]", "y"}]}]}]}]}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"nFD", "[", "c_", "]"}], "=", 
    RowBox[{
     FractionBox["1", 
      RowBox[{"2", 
       SuperscriptBox["\[Pi]", "2"]}]], 
     RowBox[{
      SubsuperscriptBox["\[Integral]", "0", "Infinity"], 
      RowBox[{
       FractionBox[
        SuperscriptBox["y", "2"], 
        RowBox[{"(", 
         RowBox[{
          SuperscriptBox["\[ExponentialE]", 
           RowBox[{"y", "-", "c"}]], "+", "1"}], ")"}]], 
       RowBox[{"\[DifferentialD]", "y"}]}]}]}]}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"\[Rho]FD", "[", "0", "]"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Simplify", "@", 
    RowBox[{"Normal", "@", 
     RowBox[{"Series", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"\[Rho]FD", "[", "c", "]"}], "+", 
        RowBox[{"\[Rho]FD", "[", 
         RowBox[{"-", "c"}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"c", ",", "0", ",", "10"}], "}"}]}], "]"}]}]}], 
   "*)"}]}]], "Input",
 CellChangeTimes->{{3.719810734101269*^9, 3.7198107471472273`*^9}, {
  3.719810815158649*^9, 3.71981082002866*^9}, {3.719811098574154*^9, 
