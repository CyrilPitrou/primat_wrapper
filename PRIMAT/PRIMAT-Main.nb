    SuperscriptBox[
     RowBox[{"(", 
      FractionBox[
       RowBox[{"T\[Nu]overTIncompleteDecouplingNoQED", "[", "Tv", "]"}], 
       RowBox[{"T\[Nu]overTDecouplingNoQED", "[", "Tv", "]"}]], ")"}], 
     "4"]}]}], ";"}]}], "Input",
 InitializationCell->True,
