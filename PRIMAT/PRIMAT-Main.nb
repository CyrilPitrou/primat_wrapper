Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "When", " ", "providing", " ", "different", " ", "files", " ", "for", " ", 
    "neutrinos", " ", "and", " ", "antineutrinos"}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"FileNEVOneutrinos", " ", "=", " ", 
     RowBox[{
     "\"\<CSV/NEVOneutrinos\>\"", "<>", "$FileSuffix", "<>", 
      "\"\<.csv\>\""}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"FileNEVOantineutrinos", " ", "=", " ", 
     RowBox[{
     "\"\<CSV/NEVOantineutrinos\>\"", "<>", "$FileSuffix", "<>", 
      "\"\<.csv\>\""}]}], ";"}], "*)"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"FileNEVOneutrinos", " ", ":=", " ", 
     RowBox[{"$CSVDirectory", "<>", 
      RowBox[{"If", "[", 
       RowBox[{"$QEDPlasmaCorrections", ",", 
        RowBox[{"If", "[", 
         RowBox[{
         "$QEDOe3", ",", " ", "\"\<NEVOPRIMAT\>\"", " ", ",", 
          "\"\<NEVOPRIMAT_QED2\>\""}], "]"}], ",", 
        "\"\<NEVOPRIMAT_NoQED\>\""}], "]"}], "<>", "$LocalSuffix", "<>", 
      "\"\<.csv\>\""}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"FileNEVOantineutrinos", " ", ":=", " ", "FileNEVOneutrinos"}], 
    ";"}], "\[IndentingNewLine]"}]}]], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.9361933219730387`*^9, 3.936193354581106*^9}, {
   3.936193459981976*^9, 3.936193460493421*^9}, {3.9363670532799263`*^9, 
   3.936367083784943*^9}, {3.936401478000141*^9, 3.936401482111483*^9}, 
   3.936405311480904*^9, {3.9365308464519243`*^9, 3.9365310210881367`*^9}, {
   3.936531217702137*^9, 3.9365312284921494`*^9}, {3.936531413665571*^9, 
   3.9365314155495043`*^9}, {3.936531470878566*^9, 3.936531472366757*^9}, {
   3.936531751879203*^9, 3.936531753634294*^9}, {3.937025684684472*^9, 
   3.937025687886325*^9}, {3.93702575352951*^9, 3.937025917689995*^9}, {
   3.9370260875723867`*^9, 3.9370260923013887`*^9}, 3.937181040521008*^9, {
