Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"FDp", "[", 
    RowBox[{"Energy_", ",", "x_"}], "]"}], "=", 
   RowBox[{"D", "[", 
    RowBox[{
     FractionBox["1", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Exp", "[", 
         RowBox[{"x", " ", "Energy"}], "]"}], "+", "1"}], ")"}]], ",", 
     "Energy"}], "]"}]}], ";"}]], "Input",
 InitializationCell->True,
