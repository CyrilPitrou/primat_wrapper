       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"NIntegrate", "[", 
         RowBox[{
          RowBox[{"C1dE", "[", 
           RowBox[{"en", ",", "x", ",", 
            RowBox[{"If", "[", 
