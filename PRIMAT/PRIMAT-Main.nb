Cell[TextData[{
 "We check that formally nucleons are conserved. So we compute formally the \
",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CapitalSigma]", "i"], " ", 
    SubscriptBox["A", "i"], 
    RowBox[{
     SubscriptBox["dY", "i"], "/", "dt"}], " ", "and", " ", "check", " ", 
    "that", " ", "it", " ", "is", " ", "0."}], TraditionalForm]],
  ExpressionUUID->"4c6bf003-a249-4f8c-8bba-9a5847a8d748"]
}], "Text",
