      RowBox[{"km", "/", "s"}], "/", "Mpc"}], " ", "so", " ", "that", " ", 
     "h"}], " ", "=", " ", 
    RowBox[{"H0", "/", "H100"}]}], " ", "*)"}]}]}], "Input",
