Cell[BoxData[
 FractionBox["1", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     SuperscriptBox["a", 
      RowBox[{"3", "+", 
       RowBox[{"3", " ", "wn"}]}]], "+", 
     SuperscriptBox["ac", 
      RowBox[{"3", "+", 
       RowBox[{"3", " ", "wn"}]}]]}], ")"}], " ", 
   RowBox[{"(", 
    RowBox[{"1", "+", "wn"}], ")"}]}]]], "Output",
