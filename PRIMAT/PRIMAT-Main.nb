Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"\[Chi]", "[", 
    RowBox[{"en_", ",", "pe_", ",", "x_", ",", "znu_", ",", "sgnq_"}], "]"}], 
   ":=", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"q", "=", 
       RowBox[{"Q", "/", "me"}]}], " ", "}"}], ",", 
     RowBox[{
      RowBox[{"FD\[Nu]", "[", 
       RowBox[{
        RowBox[{"en", "-", 
         RowBox[{"sgnq", " ", "q"}]}], ",", 
        RowBox[{"sgnq", " ", "\[Xi]\[Nu]"}], ",", "znu"}], "]"}], 
      RowBox[{"FD", "[", 
       RowBox[{
        RowBox[{"-", "en"}], ",", "x"}], "]"}], 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"en", "-", 
         RowBox[{"sgnq", " ", "q"}]}], ")"}], "2"]}]}], "]"}]}], 
  ";"}]], "Input",
