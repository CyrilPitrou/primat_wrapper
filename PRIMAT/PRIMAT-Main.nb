Cell[CellGroupData[{

Cell["Collecting all finite-temperature corrections", "Subsection",
 CellChangeTimes->{{3.722696641227968*^9, 3.722696695615993*^9}, {
  3.7226968087823887`*^9, 3.722696842882162*^9}, {3.722696951498478*^9, 
