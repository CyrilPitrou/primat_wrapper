Cell["\<\
The \[Eta] parameter is then obtained from the baryon density fraction as\
\>", "Text",
 InitializationCell->True,
 CellChangeTimes->{{3.694750821096409*^9, 3.694750837915784*^9}, 
   3.698483428030957*^9},ExpressionUUID->"704e5f43-0196-4635-ae48-\
cbeb2c4d93f3"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Eta]factor", ":=", 
   FractionBox["h2\[CapitalOmega]b0", "\[CapitalOmega]bh2Over\[Eta]"]}], 
  ";"}]], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.6942617598798037`*^9, 3.694261788468391*^9}, {
