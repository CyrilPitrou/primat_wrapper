Cell[BoxData[
 RowBox[{
  RowBox[{
  "We", " ", "make", " ", "a", " ", "list", " ", "of", " ", "the", " ", 
   SubscriptBox["Y", "i"], " ", "for", " ", "a", " ", "given", " ", "period", 
   " ", "at", " ", "a", " ", "given", " ", 
   RowBox[{"time", ".", " ", "If"}], " ", "there", " ", "is", " ", "no", " ", 
   "known", " ", "numerical", " ", "value", " ", "it", " ", "takes", " ", 
   "the", " ", "thermostatistical", " ", 
   RowBox[{"equilibrium", ".", "\[IndentingNewLine]", "This"}], " ", "is", 
   " ", "only", " ", "used", " ", "for", " ", "the", " ", "initial", " ", 
   "conditions", " ", "in", " ", "the", " ", "middle", " ", "era"}], ",", " ", 
  RowBox[{
  "where", " ", "all", " ", "species", " ", "considered", " ", "start", " ", 
   "at", " ", "thermodynamical", " ", "equilibrium", " ", "or", " ", "not", 
   " ", "very", " ", "far", " ", "from", " ", "it", " ", "except", " ", "for",
    " ", "neutrons", " ", "and", " ", "protons", " ", "which", " ", "are", 
   " ", "computed", " ", "numerically", " ", "from", " ", "the", " ", "high", 
   " ", "temperature", " ", 
   RowBox[{"era", "."}]}]}]], "Text",
 CellChangeTimes->{{3.717505594888953*^9, 3.7175056843218937`*^9}},
 FontFamily->"Arial",ExpressionUUID->"b917a7e4-0138-4756-91d6-fa7a47f9a949"],

