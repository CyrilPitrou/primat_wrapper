Cell[BoxData[
 RowBox[{"Computeaoft", ":=", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{"aoft", "=", 
     RowBox[{"NDSolveValue", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"av", "'"}], "[", "tv", "]"}], "\[Equal]", 
          FractionBox["1", 
           RowBox[{
            RowBox[{"tofa", "'"}], "[", 
            RowBox[{"av", "[", "tv", "]"}], "]"}]]}], ",", 
         RowBox[{
          RowBox[{"av", "[", 
           RowBox[{"tofa", "@", 
            RowBox[{"a", "[", "Ti", "]"}]}], "]"}], "\[Equal]", 
          RowBox[{"a", "[", "Ti", "]"}]}]}], "}"}], ",", "av", ",", 
       RowBox[{"{", 
        RowBox[{"tv", ",", 
         RowBox[{"tofa", "@", 
          RowBox[{"a", "[", "Ti", "]"}]}], ",", 
         RowBox[{"tofa", "@", 
          RowBox[{"a", "[", "Tf", "]"}]}]}], "}"}], ",", 
       RowBox[{"PrecisionGoal", "\[Rule]", "13"}], ",", 
       RowBox[{"AccuracyGoal", "\[Rule]", "25"}]}], "]"}]}], ";"}], 
