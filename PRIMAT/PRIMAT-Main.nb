         "Since", " ", "the", " ", "grid", " ", "in", " ", "x", " ", "is", 
          " ", "logarithmic"}], ",", " ", 
         RowBox[{
         "and", " ", "the", " ", "grid", " ", "in", " ", "y", " ", "is", " ", 
          "irregular", " ", 
          RowBox[{"(", 
           RowBox[{"Gauss", "-", 
            RowBox[{"Laguerre", " ", "Quadrature", " ", "possibly"}]}], 
           ")"}]}], ",", " ", 
         RowBox[{
         "Mathematica", " ", "cannot", " ", "perform", " ", "a", " ", "2", 
          "D", " ", 
          RowBox[{"interpolation", ".", " ", "To"}], " ", "bypass", " ", 
          "this", " ", "problem"}], ",", " ", 
         RowBox[{
         "we", " ", "first", " ", "interpolate", " ", "the", " ", "spectra", 
          " ", "for", " ", "each", " ", "xNEVO"}]}], "*)"}], "\n", "        ", 
       RowBox[{
        RowBox[{"LinearTable2DNue", "[", "fn", "]"}], "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Interpolation", "[", 
            RowBox[{"Transpose", "[", 
             RowBox[{"{", 
              RowBox[{"TableGrid", ",", 
               RowBox[{"TableNEVO", "[", 
                RowBox[{"[", 
                 RowBox[{"xi", ",", 
                  RowBox[{"Table", "[", 
                   RowBox[{
                    RowBox[{"6", "+", "i"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"i", ",", "1", ",", "GS"}], "}"}]}], "]"}]}], 
                 "]"}], "]"}]}], "}"}], "]"}], "]"}], "[", "LinearGrid", 
           "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"xi", ",", "1", ",", 
            RowBox[{"Lengthxrange", "[", "fn", "]"}]}], "}"}]}], "]"}]}], ";",
        "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{
         RowBox[{
         "And", " ", "we", " ", "then", " ", "use", " ", "these", " ", 
          "interpolations", " ", "to", " ", "resample", " ", "the", " ", 
          "spectrum", " ", "at", " ", "each", " ", "xNEVO"}], ",", " ", 
         RowBox[{"on", " ", "a", " ", "linear", " ", "grid", " ", "of", " ", 
          RowBox[{"y", "."}]}]}], "*)"}], "\n", 
       RowBox[{"(*", " ", 
        RowBox[{
         RowBox[{"The", " ", "Log", 
          RowBox[{"(", "xNEVO", ")"}], " ", "grid", " ", "is", " ", 
          "linearly", " ", "spaced"}], ",", " ", 
         RowBox[{
         "and", " ", "we", " ", "now", " ", "have", " ", "a", " ", "2", "D", 
          " ", "linearly", " ", "spaced", " ", "grid", " ", "that", " ", "we",
           " ", "can", " ", "interpolate", " ", "in", " ", "two", " ", 
          "dimensions"}]}], " ", "*)"}], "\[IndentingNewLine]", " ", 
       RowBox[{
        RowBox[{"dfNuelogxy", "[", "fn", "]"}], "=", 
        RowBox[{"Interpolation", "@", 
         RowBox[{"Flatten", "[", 
          RowBox[{
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"Re", "@", 
                  RowBox[{
                   RowBox[{"LogxNEVO", "[", "fn", "]"}], "[", 
                   RowBox[{"[", "lxi", "]"}], "]"}]}], ",", 
                 RowBox[{"LinearGrid", "[", 
                  RowBox[{"[", "yi", "]"}], "]"}]}], "}"}], ",", 
               RowBox[{
                RowBox[{"LinearTable2DNue", "[", "fn", "]"}], "[", 
                RowBox[{"[", 
                 RowBox[{"lxi", ",", "yi"}], "]"}], "]"}]}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"yi", ",", "1", ",", "Ny"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"lxi", ",", "1", ",", 
               RowBox[{"Lengthxrange", "[", "fn", "]"}]}], "}"}]}], "]"}], 
           ",", "1"}], "]"}]}]}], ";", "\n", 
       RowBox[{"(*", " ", 
        RowBox[{
        "If", " ", "points", " ", "are", " ", "outside", " ", "interpolation",
          " ", "we", " ", "put", " ", "0"}], " ", "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"dfNuelogxySafey", "[", "fn", "]"}], "[", 
         RowBox[{"Lx_", ",", "y_"}], "]"}], ":=", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"y", "\[GreaterEqual]", "ymin"}], "&&", 
           RowBox[{"y", "\[LessEqual]", "ymax"}]}], ",", 
          RowBox[{
           RowBox[{"dfNuelogxy", "[", "fn", "]"}], "[", 
           RowBox[{"Lx", ",", "y"}], "]"}], ",", "0"}], "]"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{
         RowBox[{
         "If", " ", "points", " ", "are", " ", "before", " ", "or", " ", 
          "after", " ", "the", " ", "x", " ", "values", " ", "of", " ", 
          "NEVO"}], ",", " ", 
         RowBox[{"we", " ", "use", " ", "the", " ", "frozen", " ", 
          RowBox[{"(", 
           RowBox[{"initial", " ", "or", " ", "final"}], ")"}], " ", 
          "spectra"}]}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"dfNuelogxySafexSafey", "[", "fn", "]"}], "[", 
         RowBox[{"Lx_", ",", "y_"}], "]"}], ":=", 
        RowBox[{"With", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Lxmax", "=", 
             RowBox[{"Logxmax", "[", "fn", "]"}]}], ",", 
            RowBox[{"Lxmin", "=", 
             RowBox[{"Logxmin", "[", "fn", "]"}]}]}], "}"}], ",", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"Lx", "\[GreaterEqual]", "Lxmin"}], ",", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"Lx", "\[LessEqual]", 
               RowBox[{"Logxmax", "[", "fn", "]"}]}], ",", 
              RowBox[{
               RowBox[{"dfNuelogxySafey", "[", "fn", "]"}], "[", 
               RowBox[{"Lx", ",", "y"}], "]"}], ",", 
              RowBox[{
               RowBox[{"dfNuelogxySafey", "[", "fn", "]"}], "[", 
               RowBox[{"Lxmax", ",", "y"}], "]"}]}], "]"}], ",", 
            RowBox[{
             RowBox[{"dfNuelogxySafey", "[", "fn", "]"}], "[", 
             RowBox[{"Lxmin", ",", "y"}], "]"}]}], "]"}]}], " ", "]"}]}], " ",
        ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{"Finally", ",", " ", 
         RowBox[{"after", " ", "all", " ", "this"}], ",", " ", 
         RowBox[{
         "we", " ", "obtain", " ", "a", " ", "function", " ", "which", " ", 
          "depends", " ", "on", " ", "xNEVO", " ", 
          RowBox[{"(", 
           RowBox[{"the", " ", "scale", " ", "factor"}], ")"}], " ", "and", 
          " ", "the", " ", "comoving", " ", "momentum", " ", "y"}]}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"dfNuexy", "[", "fn", "]"}], "[", 
         RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
        RowBox[{
         RowBox[{"dfNuelogxySafexSafey", "[", "fn", "]"}], "[", 
         RowBox[{
          RowBox[{"Log", "@", "x"}], ",", "y"}], "]"}]}], ";"}]}], 
     "\[IndentingNewLine]", "]"}], ";"}], ")"}]}]], "Input",
 InitializationCell->True,
