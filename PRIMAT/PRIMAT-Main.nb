Cell["\<\
We check that it is in agreement with the theoretical formula. This \
expression below should reproduce the neutron decay time. It is amazingly \
close ! \
\>", "Text",
 InitializationCell->True,
 CellChangeTimes->{{3.695397605565617*^9, 3.695397616379963*^9}, {
  3.696566507009534*^9, 3.69656654022038*^9}, {3.717329600841188*^9, 
  3.717329607950241*^9}},ExpressionUUID->"6fced173-7e6b-4508-9abe-\
fb262db3de07"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"MixingCosAngle", "=", "0.97420"}], ";"}], 
  RowBox[{"(*", "  ", 
   RowBox[{"0.97420", 
    RowBox[{"(", 
     RowBox[{"+", 
      RowBox[{"-", "16"}]}], ")"}], " ", "from", " ", "PDG2017", " ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
      "The", " ", "review", " ", "on", " ", "Vud", " ", "Vus", " ", "of", " ",
        "the", " ", "PDG", " ", "2017"}], ")"}], "."}]}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "The", " ", "value", " ", "from", " ", "PDG2020", " ", "review", " ", "on",
     " ", "Vud", " ", "Vus", " ", "is", " ", "0.97370", 
    RowBox[{"(", 
     RowBox[{"+", 
      RowBox[{"-", "20"}]}], ")"}], " ", "but", " ", "this", " ", "brings", 
    " ", "tension", " ", "on", " ", "the", " ", "unitarity", " ", "of", " ", 
    "the", " ", "CKM", " ", 
    RowBox[{"matrix", ".", " ", "Hence"}], " ", "we", " ", "stick", " ", "to",
     " ", "the", " ", "previous", " ", 
    RowBox[{"value", ".", " ", "This"}], " ", "is", " ", "only", " ", "used", 
    " ", "to", " ", "check", " ", "if", " ", "one", " ", "recovers", " ", 
    "from", " ", "theory", " ", "the", " ", "neutrino", " ", 
    RowBox[{"lifetime", "."}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{"MyK", ":=", 
  RowBox[{"MyK", "=", 
   RowBox[{
    SuperscriptBox["MixingCosAngle", "2"], 
