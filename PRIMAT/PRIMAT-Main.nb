Cell["\<\
\[Eta] factor with temperature dependence (because photons density has \
evolved due to electron positron recombination)\
\>", "Text",
 CellChangeTimes->{{3.71773970651502*^9, 
  3.71773973470522*^9}},ExpressionUUID->"e4dc18e2-059f-4e14-aa8c-\
8c0057ffefbd"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"\[Eta]factorT", "[", "Tv_", "]"}], ":=", 
   RowBox[{
    RowBox[{"nB", "[", 
     RowBox[{"a", "[", "Tv", "]"}], "]"}], "*", 
    FractionBox[
     SuperscriptBox["\[Pi]", "2"], 
     RowBox[{"2", 
      RowBox[{"Zeta", "[", "3", "]"}]}]], 
    SuperscriptBox[
     RowBox[{"(", 
      FractionBox[
       RowBox[{"hbar", " ", "clight"}], 
       RowBox[{"kB", " ", "Tv"}]], ")"}], "3"]}]}], ";"}]], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.717739578298387*^9, 3.7177395790833693`*^9}, {
   3.717739738640931*^9, 3.717739840779657*^9}, {3.717754200936275*^9, 
   3.71775422908852*^9}, {3.717754262170895*^9, 3.717754289857871*^9}, 
   3.722686162286232*^9},
 CellLabel->
  "In[409]:=",ExpressionUUID->"b902d308-33a6-4eb0-bf29-7c1bd6e9f7da"],

Cell["Another way to  obtain this quantity", "Text",
 CellChangeTimes->{{3.722686163431291*^9, 
  3.722686172016715*^9}},ExpressionUUID->"6dd79688-89cd-4017-94c5-\
f811ecf1ca1b"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"\[Eta]factorTBis", "[", "Tv_", "]"}], ":=", 
   RowBox[{"\[Eta]factor", "*", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       RowBox[{"zT", "[", "Tf", "]"}], "/", 
       RowBox[{"zT", "[", "Tv", "]"}]}], ")"}], "3"]}]}], ";"}]], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.717739578298387*^9, 3.7177395790833693`*^9}, {
  3.717739738640931*^9, 3.717739840779657*^9}, {3.717754200936275*^9, 
