                    SuperscriptBox[
                    RowBox[{"me", " "}], "2"]}], ")"}], "/", 
                    RowBox[{"(", 
                    RowBox[{"2", "mn"}], ")"}]}]}], ")"}], "/", "me"}]}], " ",
                "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"Cnu", ",", 
                RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", 
              RowBox[{"PrecisionGoal", "\[Rule]", "10"}]}], 
             RowBox[{"(*", 
              RowBox[{",", 
               RowBox[{"Method", "\[Rule]", 
                RowBox[{"{", 
                 RowBox[{"Automatic", ",", 
