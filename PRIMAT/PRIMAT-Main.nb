Cell[TextData[{
 "If Plasma QED corrections are not used, then the full expression for the \
Pressure QED correction cannot be used, nor the order ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["e", "3"], " ", 
    RowBox[{"correction", "."}]}], TraditionalForm]],ExpressionUUID->
  "19f71be5-d765-4097-9396-df651624901b"]
}], "Text",ExpressionUUID->"00395cbe-efd1-4f8d-b325-ad8377b8f1ec"],

Cell[BoxData[
 RowBox[{
  RowBox[{
  "If", " ", "NEVO", " ", "results", " ", "are", " ", "not", " ", "used", " ",
    "for", " ", "neutrino", " ", "decoupling"}], ",", " ", 
  RowBox[{
  "then", " ", "we", " ", "cannot", " ", "have", " ", "the", " ", "true", " ", 
   SubscriptBox["\[Nu]", "e"], " ", 
   RowBox[{"temperature", ".", " ", "\[IndentingNewLine]", "If"}], " ", "we", 
   " ", "do", " ", "not", " ", "use", " ", "NEVO", " ", "and", " ", "there", 
   " ", "are", " ", "no", " ", "AnalyticDistortions"}], ",", " ", 
  RowBox[{"then", " ", "we", " ", "cannot", " ", "have", " ", "Spectral", " ", 
   RowBox[{"Distortions", "."}]}]}]], "Text",
 CellChangeTimes->{
  3.9349607362074757`*^9, {3.934960795688324*^9, 3.934960831811574*^9}, {
