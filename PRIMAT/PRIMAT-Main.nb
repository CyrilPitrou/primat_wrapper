Cell[TextData[{
 "We also check that computing  a(t(a)) gives negligible error to identity. \
It is of order ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["10", 
     RowBox[{"-", "9"}]], "so", " ", "we", " ", "are", " ", "totally", " ", 
    RowBox[{"OK", "."}]}], TraditionalForm]],ExpressionUUID->
  "47076748-9b54-4cf8-bee0-f4e22717b56e"]
}], "Text",
 CellChangeTimes->{{3.7159519893817596`*^9, 
  3.715952026252974*^9}},ExpressionUUID->"c0c4cd3b-0105-46ce-9f70-\
2c98dd0c2738"],

