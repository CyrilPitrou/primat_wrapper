  3.7226859222314043`*^9}},ExpressionUUID->"6d16adcb-0659-40f2-8467-\
dba3a79ce037"],

Cell["\<\
We check the translation into equivalent number of neutrinos. See section \
II.G of companion paper for the definition of Neff.
This section is only informative.\
\>", "Text",ExpressionUUID->"cefbf0c1-cea1-4dca-8f64-6228541f5753"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"T\[Nu]overTDecouplingNoQED", "[", "T_", "]"}], ":=", 
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"FourOverElevenNoQED", "*", " ", 
      RowBox[{"DSTNoQED", "[", "T", "]"}]}], ")"}], 
    RowBox[{"(", 
     RowBox[{"1", "/", "3"}], ")"}]]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"T\[Nu]overTDecouplingQED", "[", "T_", "]"}], ":=", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"FourOverElevenQED", "*", " ", 
       RowBox[{"DSTQED", "[", "T", "]"}]}], ")"}], 
     RowBox[{"(", 
      RowBox[{"1", "/", "3"}], ")"}]]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"EffectiveNeutrinosQED", "[", "Tv_", "]"}], ":=", 
   RowBox[{"NeutrinosGenerations", 
    SuperscriptBox[
     RowBox[{"(", 
      FractionBox[
       RowBox[{"T\[Nu]overTIncompleteDecouplingQED", "[", "Tv", "]"}], 
       RowBox[{"T\[Nu]overTDecouplingNoQED", "[", "Tv", "]"}]], ")"}], 
     "4"]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"EffectiveNeutrinosNoQED", "[", "Tv_", "]"}], ":=", 
