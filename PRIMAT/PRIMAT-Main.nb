Cell["\<\
A function to load a precompiled function, or to store it if it was not \
computed and stored previously .
If $Recompile=True, then the compilation of the function is performed even if \
there is a version stored and it tries to delete the previous library.\
\>", "Text",
 CellChangeTimes->{{3.936244160552355*^9, 3.936244223700227*^9}, {
  3.937274857879829*^9, 
  3.937274863134316*^9}},ExpressionUUID->"163dc80e-6ac0-4b39-9334-\
d97242100548"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"UniqueLibraryname", "[", 
    RowBox[{"funcLoc_", ",", "fnamestring_"}], "]"}], ":=", 
   RowBox[{"$libDirectory", "<>", "fnamestring", "<>", "\"\<.\>\"", "<>", 
    RowBox[{
     RowBox[{"StringSplit", "[", 
      RowBox[{"funcLoc", ",", "\"\<.\>\""}], "]"}], "[", 
     RowBox[{"[", 
      RowBox[{"-", "1"}], "]"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"UniqueLibraryname", "[", "funcLoc_", "]"}], ":=", 
     RowBox[{"$PackageDirectory", "<>", "\"\<lib/compiled\>\"", "<>", 
      RowBox[{"ToString", "[", 
       RowBox[{"RandomInteger", "[", 
        RowBox[{"{", 
         RowBox[{"1000", ",", "9999"}], "}"}], "]"}], "]"}], "<>", 
      "\"\<.\>\"", "<>", 
      RowBox[{
       RowBox[{"StringSplit", "[", 
        RowBox[{"funcLoc", ",", "\"\<.\>\""}], "]"}], "[", 
       RowBox[{"[", 
        RowBox[{"-", "1"}], "]"}], "]"}]}]}], ";"}], "*)"}]}]}], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.936319175447229*^9, 3.936319231590173*^9}, 
   3.9363192734547043`*^9, {3.936319485074174*^9, 3.936319490809577*^9}, 
   3.936401564688691*^9, {3.936402033022726*^9, 3.936402095991362*^9}, {
   3.9364043724032593`*^9, 3.9364043890579033`*^9}, {3.9371806508824043`*^9, 
   3.937180656697666*^9}, {3.937180833929385*^9, 3.9371808501394997`*^9}, {
   3.93718140119281*^9, 3.9371814044343443`*^9}},
 CellLabel->
  "In[213]:=",ExpressionUUID->"f6159d25-b3c3-4bd8-907d-f28073037949"],

Cell[BoxData[{
 RowBox[{"Clear", "[", "LoadCompiledFunction", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"LoadCompiledFunction", "[", 
     RowBox[{
      RowBox[{"Hold", "[", "fname_", "]"}], ",", 
      RowBox[{"Hold", "[", "functiondef_", "]"}], ",", "fnamestring_String"}],
      "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"funcLoc", ",", "ShouldCompile"}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{"$StoreCompilation", ",", "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{
           RowBox[{"fnamestring", "=", 
            RowBox[{"ToString", "[", 
             RowBox[{"HoldForm", "[", "fname", "]"}], "]"}]}], ";"}], "*)"}], 
         "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{
           RowBox[{"Print", "[", 
            RowBox[{"\"\<fnamestring is \>\"", ",", "fnamestring"}], "]"}], 
           ";"}], "*)"}], "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"mxname", "=", " ", 
           RowBox[{
           "$libDirectory", "<>", "fnamestring", "<>", "\"\<.mx\>\""}]}], ";",
           "\[IndentingNewLine]", "\[IndentingNewLine]", 
          RowBox[{"ShouldCompile", "=", "False"}], ";", "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"Not", "[", 
             RowBox[{"FileExistsQ", "[", "mxname", "]"}], "]"}], ",", 
            RowBox[{
             RowBox[{"ShouldCompile", "=", "True"}], ";"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"Get", "[", "mxname", "]"}], ";", "\[IndentingNewLine]", 
             
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"Not", "[", 
                RowBox[{"FileExistsQ", "[", "newfuncLoc", "]"}], "]"}], ",", 
               "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"ShouldCompile", "=", "True"}], ";"}], ",", 
               "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"If", "[", 
                 RowBox[{"$Recompile", ",", "\[IndentingNewLine]", 
                  RowBox[{
                   RowBox[{"Print", "[", 
                    RowBox[{
                    "\"\<I will erase the associate library : \>\"", ",", 
                    "newfuncLoc"}], "]"}], ";", "\[IndentingNewLine]", 
                   RowBox[{"DeleteFile", "[", "newfuncLoc", "]"}], ";", 
                   "\[IndentingNewLine]", 
                   RowBox[{"ShouldCompile", "=", "True"}]}]}], 
                 "\[IndentingNewLine]", "]"}], ";"}]}], "\[IndentingNewLine]",
               "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
          "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"ShouldCompile", "||", "$Recompile"}], ",", 
            "\[IndentingNewLine]", "\[IndentingNewLine]", 
            RowBox[{"(*", 
             RowBox[{
              RowBox[{"Print", "[", "cpf", "]"}], ";"}], "*)"}], 
            "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"fname", "=", "functiondef"}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"funcLoc", "=", 
              RowBox[{"fname", "[", 
               RowBox[{"[", 
                RowBox[{
                 RowBox[{"-", "1"}], ",", "1"}], "]"}], "]"}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"(*", 
              RowBox[{
               RowBox[{"newfuncLoc", "=", 
                RowBox[{"UniqueLibraryname", "[", "funcLoc", "]"}]}], ";"}], 
              "*)"}], "\[IndentingNewLine]", 
             RowBox[{"newfuncLoc", "=", 
              RowBox[{"UniqueLibraryname", "[", 
               RowBox[{"funcLoc", ",", "fnamestring"}], "]"}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"Print", "[", 
              RowBox[{
              "\"\<I store the following compiled function : \>\"", ",", 
               "fnamestring", ",", "\"\< in \>\"", ",", "mxname", ",", 
               "\"\< with library \>\"", ",", "newfuncLoc"}], "]"}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"CopyFile", "[", 
              RowBox[{"funcLoc", ",", "newfuncLoc", ",", 
               RowBox[{"OverwriteTarget", "->", "False"}]}], "]"}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"DumpSave", "[", 
              RowBox[{"mxname", ",", 
               RowBox[{"{", 
                RowBox[{"fname", ",", "newfuncLoc"}], "}"}]}], "]"}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"fname", "=", 
              RowBox[{"ReplacePart", "[", 
               RowBox[{"fname", ",", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"-", "1"}], ",", "1"}], "}"}], "->", 
                 "newfuncLoc"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
            RowBox[{"(*", 
             RowBox[{
              RowBox[{"Print", "[", 
               RowBox[{"fname", "/.", " ", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"CompiledFunction", "->", "List"}], ",", 
                  RowBox[{"LibraryFunction", "->", "List"}]}], "}"}]}], "]"}],
               ";"}], "*)"}], ",", "\[IndentingNewLine]", 
            RowBox[{"(*", 
             RowBox[{
             "If", " ", "exists", " ", "already", " ", "we", " ", "load", " ",
               "it", " ", "and", " ", "fo", " ", "the", " ", "appropriate", 
              " ", "replacement", " ", "of", " ", "library", " ", 
              RowBox[{"paths", "."}]}], "*)"}], "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"Get", "[", "mxname", "]"}], ";", "\[IndentingNewLine]", 
             
             RowBox[{"If", "[", 
              RowBox[{"$Verbose", ",", 
               RowBox[{
                RowBox[{"Print", "[", 
                 RowBox[{
                 "\"\<I load compiled function from \>\"", ",", "mxname", 
                  ",", "\"\< and the library linked is \>\"", ",", 
                  "newfuncLoc"}], "]"}], ";"}]}], "]"}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"fname", "=", 
              RowBox[{"ReplacePart", "[", 
               RowBox[{"fname", ",", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"-", "1"}], ",", "1"}], "}"}], "->", 
                 "newfuncLoc"}]}], "]"}]}], ";"}]}], "\[IndentingNewLine]", 
           RowBox[{"(*", 
            RowBox[{
             RowBox[{"Print", "[", 
              RowBox[{"fname", "/.", " ", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"CompiledFunction", "->", "List"}], ",", 
                 RowBox[{"LibraryFunction", "->", "List"}]}], "}"}]}], "]"}], 
             ";"}], "*)"}], "\[IndentingNewLine]", "]"}], ";"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"fname", "=", "functiondef"}], ";"}]}], "]"}], ";"}]}], 
     "\[IndentingNewLine]", "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"LoadCompiledFunction", "[", 
    RowBox[{
     RowBox[{"Hold", "[", "fname_", "]"}], ",", 
     RowBox[{"Hold", "[", "functiondef_", "]"}]}], "]"}], ":=", 
   RowBox[{"LoadCompiledFunction", "[", 
    RowBox[{
     RowBox[{"Hold", "[", "fname", "]"}], ",", 
     RowBox[{"Hold", "[", "functiondef", "]"}], ",", 
     RowBox[{"ToString", "[", 
      RowBox[{"HoldForm", "[", "fname", "]"}], "]"}]}], "]"}]}], 
  ";"}]}], "Input",
 InitializationCell->True,
 CellChangeTimes->CompressedData["
