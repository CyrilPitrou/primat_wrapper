Cell[BoxData[
 RowBox[{
  RowBox[{"ListColor", "[", 
   RowBox[{"Color_", ",", "n_"}], "]"}], ":=", 
  RowBox[{"Take", "[", 
   RowBox[{
    RowBox[{"Join", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{"Color", ",", 
         RowBox[{"Thickness", "[", "0.004", "]"}]}], "}"}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"Color", ",", 
          RowBox[{"Thickness", "[", "0.004", "]"}], ",", 
          RowBox[{"Dashing", "[", 
           RowBox[{
            RowBox[{"(", "i", ")"}], "0.01"}], "]"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", "3"}], "}"}]}], "]"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"Color", ",", 
          RowBox[{"Thickness", "[", "0.004", "]"}], ",", 
          RowBox[{"Dashing", "[", 
           RowBox[{"{", 
            RowBox[{"0", ",", 
             RowBox[{"0.015", "*", "i"}], ",", 
             RowBox[{
              RowBox[{"(", "i", ")"}], "0.015"}], ",", 
             RowBox[{"i", " ", "0.015"}]}], "}"}], "]"}]}], "}"}], ",", 
        RowBox[{"{", 
