Cell[BoxData[
 RowBox[{"We", " ", "now", " ", "solve", " ", "d", " ", 
  RowBox[{
   RowBox[{"(", 
    SubscriptBox["\[Rho]", "\[Nu]"], ")"}], "/", "d"}], " ", "ln", 
  RowBox[{"(", "a", ")"}], " ", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{
     "we", " ", "have", " ", "to", " ", "pay", " ", "attention", " ", "to", 
      " ", "units"}], ",", " ", 
     RowBox[{
     "hence", " ", "the", " ", "hbar", " ", "and", " ", "clight", " ", 
      "placed", " ", "in", " ", "the", " ", "system"}]}], ")"}], 
   "."}]}]], "Text",
 CellChangeTimes->{{3.70056051116332*^9, 3.700560565800734*^9}, {
  3.70056061848757*^9, 3.7005606337338123`*^9}, {3.71602845755551*^9, 
