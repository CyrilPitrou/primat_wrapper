  FormBox[
   RowBox[{" ", 
    RowBox[{
     SuperscriptBox[
      SubscriptBox["\[Tau]", "n"], 
      RowBox[{"-", "1"}]], "=", " ", 
     RowBox[{
      SubscriptBox["\[Lambda]", "0"], "*", " ", 
      RowBox[{"[", 
       RowBox[{
        RowBox[{
         SuperscriptBox["cos", "2"], "(", 
         SubscriptBox["\[Theta]", "c"], ")"}], 
        RowBox[{
         RowBox[{
          SuperscriptBox[
           SubscriptBox["G", "F"], "2"], "(", 
          RowBox[{
           SuperscriptBox[
            SubscriptBox["C", "V"], "2"], "+", 
           RowBox[{"3", 
            SuperscriptBox[
             SubscriptBox["C", "A"], "2"]}]}], ")"}], "/", 
         RowBox[{"(", 
          RowBox[{"2", 
           SuperscriptBox["\[Pi]", "3"]}], ")"}]}]}], " ", "]"}], " "}]}]}], 
   TraditionalForm]],ExpressionUUID->"a7fa58c9-b195-474f-b133-411d6d7a1442"]
}], "Text",
