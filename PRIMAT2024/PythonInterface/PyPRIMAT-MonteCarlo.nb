Cell[BoxData[{
 RowBox[{
  RowBox[{"$ParallelBool", "=", "True"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"$RandomNuclearRates", "=", "True"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"$Random\[Tau]neutron", "=", "True"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"$Randomh2\[CapitalOmega]b", "=", "False"}], ";"}], 
  RowBox[{"(*", 
