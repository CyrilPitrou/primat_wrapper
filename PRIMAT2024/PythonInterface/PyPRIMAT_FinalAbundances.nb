Cell[CellGroupData[{

Cell["\<\
Storing results in a file which we will then recover in python\
\>", "Subsection",
 CellChangeTimes->{{3.935556617995866*^9, 3.93555664710432*^9}, {
  3.9355566946969357`*^9, 
  3.9355567032416143`*^9}},ExpressionUUID->"29568799-070b-4571-be02-\
73e7380800a7"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"AllResults", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"#", ",", 
       RowBox[{"Yf", "[", "#", "]"}]}], "}"}], "&"}], "/@", "ShortNames"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"ImportResults", "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\"\<Neff\>\"", ",", "Neff"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"\"\<YP\>\"", ",", 
        RowBox[{"4", 
         RowBox[{"Yf", "[", "\"\<a\>\"", "]"}]}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"\"\<D/H\>\"", ",", 
        RowBox[{"YfH", "[", "\"\<d\>\"", "]"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"\"\<He3/H\>\"", ",", 
        RowBox[{
         RowBox[{"YfH", "[", "\"\<t\>\"", "]"}], "+", 
         RowBox[{"YfH", "[", "\"\<He3\>\"", "]"}]}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"\"\<Li7/H\>\"", ",", 
        RowBox[{
         RowBox[{"YfH", "[", "\"\<Li7\>\"", "]"}], "+", 
         RowBox[{"YfH", "[", "\"\<Be7\>\"", "]"}]}]}], "}"}]}], "}"}]}], 
   ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"TableResults", " ", "=", 
   RowBox[{"Join", "[", 
    RowBox[{"ImportResults", ",", "AllResults"}], "]"}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<Results are \>\"", ",", "TableResults"}], "]"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Export", "[", 
   RowBox[{"$Outputfile", ",", "TableResults", ",", "\"\<CSV\>\""}], "]"}], 
  ";"}]}], "Input",
 InitializationCell->True,
